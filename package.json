{
  "name": "enclavetools",
  "version": "1.0.0",
  "description": "Stop paying for AI APIs. Everything here runs on your hardware.",
  "type": "module",
  "private": false,
  "main": "src/data/tools.json",
  "files": [
    "src/data/tools.json",
    "src/data/generated/tools/*.json",
    "src/data/metadata.json",
    "src/data/generated/slug-map.json",
    "src/data/generated/tool-metadata/*.json"
  ],
  "exports": {
    ".": "./src/data/tools.json",
    "./tools": "./src/data/tools.json",
    "./metadata": "./src/data/metadata.json",
    "./slug-map": "./src/data/generated/slug-map.json",
    "./categories/*": "./src/data/generated/tools/*.json",
    "./tool/*": "./src/data/generated/tool-metadata/*.json"
  },
  "scripts": {
    "clean": "rm -rf dist .astro src/data/generated",
    "prepare-data": "bun run scripts/split-data.ts && bun run scripts/generate-slug-map.ts && bun run scripts/generate-tool-metadata.ts && bun run scripts/sync-logos.ts",
    "prepublishOnly": "bun run prepare-data",
    "dev": "bun run prepare-data && astro dev",
    "start": "astro dev",
    "build": "bun run prepare-data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:spacing": "bash scripts/lint-spacing.sh",
    "build-data": "bun run scripts/build-data.ts",
    "sync-pipeline": "bun run scripts/sync-pipeline.ts",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vue": "^6.0.1",
    "@orama/orama": "^3.1.18",
    "@tailwindcss/typography": "^0.5.20",
    "@vueuse/core": "^14.3.0",
    "astro": "^6.3.7",
    "punycode": "^2.3.1",
    "sharp": "^0.34.5",
    "vue": "^3.5.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "node-html-parser": "^7.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.1"
  },
  "keywords": [
    "directory",
    "ai",
    "tools",
    "listing",
    "curated",
    "makers",
    "smb",
    "ai-agents"
  ],
  "author": "@mamylinx",
  "license": "MIT",
  "overrides": {
    "vite": "^7",
    "yaml": "^2.7.0",
    "minimatch": "^10.0.0",
    "picomatch": "^4.0.0",
    "smol-toml": "^1.6.1",
    "ajv": "^8.18.0",
    "postcss": "^8.5.10",
    "uuid": "^13.0.1",
    "fast-uri": "^3.1.1",
    "rollup": "^4.59.0",
    "devalue": "^5.8.1"
  }
}
