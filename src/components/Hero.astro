---
interface Props {
  eyebrow?: string;
  title?: string;
  tagline?: string;
}

const {
  eyebrow,
  title,
  tagline,
} = Astro.props;
---

<div
  class="text-center relative overflow-hidden flex flex-col items-center justify-center py-24 px-8 border-b border-gray-200"
>
  <header class="max-w-3xl">
    {eyebrow && (
      <p class="inline-flex items-center bg-primary-50 text-primary-600 rounded-full px-3 py-1 text-xs font-bold mb-4">
        {eyebrow}
      </p>
    )}
    {title && (
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 mb-6 leading-[1.1]">
        <strong class="font-black">{title}</strong>
      </h1>
    )}
    {tagline && (
      <p class="text-xl text-gray-600 font-medium leading-relaxed">
        {tagline}
      </p>
    )}
    <slot />
  </header>
</div>
