---
interface Props {
  eyebrow?: string;
  title: string;
  tagline: string;
}

const {
  eyebrow = "Offgrid AI tools · Updated daily",
  title,
  tagline,
} = Astro.props;
---

<div
  class="text-center relative overflow-hidden flex flex-col items-center justify-center py-16 px-8"
>
  <header class="max-w-3xl">
    <p
      class="text-primary-500 font-black uppercase tracking-widest text-sm mb-4 block"
    >
      {eyebrow}
    </p>
    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 mb-6 leading-[1.1]"
    >
      <strong class="font-black">{title}</strong>
    </h1>
    <p class="text-xl text-gray-600 font-medium leading-relaxed">
      {tagline}
    </p>
    <slot />
  </header>
</div>
