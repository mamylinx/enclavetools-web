---
interface Props {
  title: string;
  tagline: string;
}

const { title, tagline } = Astro.props;
---

<div class="hero">
  <p class="hero-eyebrow">Offgrid AI tools · Updated daily</p>
  <h1 class="hero-title smooth-color-fade">
    <strong>{title}</strong>
  </h1>
  <p class="hero-tagline">
    {tagline}
  </p>
</div>

<style>
  .hero {
    margin-bottom: 0;
    margin-top: 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }

  .hero-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 300;
    letter-spacing: -1px;
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .hero-title strong {
    font-weight: 600;
  }

  .hero-tagline {
    font-size: 15px;
    color: var(--text-primary);
  }

  :global(.search-container) {
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
</style>
