---
import CalcSummaryBar from "./calculator/CalcSummaryBar.astro";
import CalcStepIndicator from "./calculator/CalcStepIndicator.astro";
import CalcStep1 from "./calculator/CalcStep1.astro";
import CalcStep2 from "./calculator/CalcStep2.astro";
import CalcStep3 from "./calculator/CalcStep3.astro";
import CalcStep4 from "./calculator/CalcStep4.astro";
import CalcStep5 from "./calculator/CalcStep5.astro";
import CalcResults from "./calculator/CalcResults.astro";
import CalcActionBar from "./calculator/CalcActionBar.astro";
---

<div id="calcRoot" class="max-w-3xl mx-auto px-4 py-6 lg:py-8 min-w-0">
  <div class="text-center mb-4">
    <h1
      class="text-xl font-extrabold text-brand-forest tracking-tight mb-2 leading-tight text-wrap-balance max-w-lg mx-auto"
    >
      AI Hardware Sizing Calculator
    </h1>
  </div>

  <CalcSummaryBar />

  <CalcStepIndicator currentStep={1} />

  <div id="calc-content">
    <CalcStep1 />
    <CalcStep2 />
    <CalcStep3 />
    <CalcStep4 />
    <div id="step5" class="hidden fade-in">
      <CalcStep5 />
      <CalcResults />
      <CalcActionBar />
    </div>
  </div>
</div>

<script>
  import "../scripts/llm-calculator/main.ts";
</script>
