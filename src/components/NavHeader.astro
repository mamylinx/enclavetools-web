---
import siteContent from "../data/site-content.json";
import categories from "../data/categories.json";
import SearchInput from "./SearchInput.vue";

const c = siteContent as Record<string, string>;
const {
  showSearch = false,
  searchPlaceholder = "Search by name, category, or feature...",
} = Astro.props;
---

<a
  href="#main-content"
  class="absolute -top-[100px] left-1/2 -translate-x-1/2 px-3 py-1 bg-brand-forest text-white no-underline font-bold uppercase tracking-wider z-[9999999] transition-[top] duration-200 text-xs focus:top-1 border border-brand-forest/10 rounded-full shadow-sm"
  >Skip to main content</a
>

<nav
  class="sticky top-0 z-[1000] bg-white/95 backdrop-blur-sm border-b border-brand-forest/10"
  transition:persist="header-nav"
>
  <div
    class="max-w-[1400px] mx-auto px-6 lg:px-12 flex items-center justify-between h-20"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-3 shrink-0"
      aria-label="Enclavetools homepage"
    >
      <span
        class="w-11 h-11 bg-brand-forest rounded-xl flex items-center justify-center border border-brand-forest/10"
      >
        <svg
          class="w-6 h-6 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path>
        </svg>
      </span>
      <span
        class="font-sans font-extrabold text-lg text-brand-forest tracking-tight"
        >Enclavetools</span
      >
    </a>

    <!-- Desktop Search -->
    <div class="hidden md:block flex-1 max-w-sm mx-8">
      <SearchInput client:load placeholder={searchPlaceholder} />
    </div>

    <!-- Desktop Links with Mega Dropdown -->
    <div class="hidden lg:flex items-center gap-8">
      <!-- Categories Trigger -->
      <div class="relative group">
        <button
          class="flex items-center gap-1.5 text-xs font-extrabold text-brand-forest/80 hover:text-brand-teal uppercase tracking-widest py-6 focus:outline-none transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          {c.nav_all_categories || "Categories"}
          <svg
            class="w-3.5 h-3.5 transition-transform group-hover:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Categories Dropdown -->
        <div
          class="absolute left-0 top-full mt-0 w-[700px] bg-white border border-brand-forest/10 shadow-2xl rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-[1000] p-6"
        >
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-2">
            {
              categories
                .filter((cat) => cat.category !== "all")
                .map((cat) => (
                  <a
                    href={`/${cat.category}`}
                    class="flex items-center px-3 py-2 text-xs font-bold uppercase tracking-wider text-brand-forest hover:bg-brand-tealLight hover:text-brand-teal rounded-xl transition-colors"
                    data-category={cat.category}
                  >
                    {cat.title}
                  </a>
                ))
            }
          </div>
          <div class="mt-6 pt-4 border-t border-brand-forest/10 text-right">
            <a
              href="/all"
              class="text-sm font-bold text-brand-forest uppercase tracking-[0.1em] hover:text-brand-teal inline-flex items-center gap-1.5 font-sans transition-colors"
            >
              ➔ Browse All Categories
            </a>
          </div>
        </div>
      </div>

      <a
        href="/compare"
        class="text-xs font-extrabold text-brand-forest/80 hover:text-brand-teal transition-colors uppercase tracking-widest"
        >{c.nav_compare || "Compare"}</a
      >
      <a
        href="/stack-builder"
        class="text-xs font-extrabold text-brand-forest/80 hover:text-brand-teal transition-colors uppercase tracking-widest"
        >{c.nav_stack || "Stack Builder"}</a
      >
    </div>

    <!-- Action Button + Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href="/submit"
        class="h-10 px-5 bg-brand-forest text-white text-xs font-bold rounded-full uppercase tracking-wider hover:bg-black inline-flex items-center transition-all shadow-sm"
      >
        Submit
        <svg
          class="w-4 h-4 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
      <button
        id="mobile-toggle"
        class="lg:hidden w-10 h-10 flex items-center justify-center text-brand-forest bg-brand-bg border border-brand-forest/10 rounded-full"
        aria-label="Menu"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-brand-forest/10"
  >
    <div class="px-6 py-6 flex flex-col gap-4">
      <div class="relative mb-2">
        <label for="mobile-search" class="sr-only">Search tools</label>
        <input
          type="text"
          id="mobile-search"
          placeholder="Search tools..."
          class="w-full h-11 pl-10 pr-4 bg-brand-bg border border-brand-forest/5 rounded-full text-sm font-medium placeholder-gray-400 focus:outline-none"
          aria-label="Search tools"
        />
        <svg
          class="w-4 h-4 text-brand-muted absolute left-3.5 top-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <a
        href="/all"
        class="text-xs font-bold text-brand-forest py-1 hover:text-brand-teal uppercase tracking-wider transition-colors"
        >Browse Directory</a
      >
      <a
        href="/compare"
        class="text-xs font-bold text-brand-forest py-1 hover:text-brand-teal uppercase tracking-wider transition-colors"
        >Compare tools</a
      >
      <a
        href="/stack-builder"
        class="text-xs font-bold text-brand-forest py-1 hover:text-brand-teal uppercase tracking-wider transition-colors"
        >Stack builder</a
      >
    </div>
  </div>
</nav>

<!-- Mobile search panel (when showSearch prop is true) -->
{
  showSearch && (
    <div
      class="md:hidden overflow-hidden transition-all duration-200 max-h-0 relative z-30"
      id="mobileSearchPanel"
    >
      <div class="px-4 py-4 bg-white border-b border-brand-forest/10">
        <SearchInput client:load placeholder={searchPlaceholder} />
      </div>
    </div>
  )
}

<script>
  // Mobile navigation toggle
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  // Additional accessibility: set external link attributes
  document.querySelectorAll('a[target="_blank"]').forEach((link) => {
    if (!link.getAttribute("rel"))
      link.setAttribute("rel", "noopener noreferrer");
  });
</script>
