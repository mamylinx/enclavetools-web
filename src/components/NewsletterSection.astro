---
interface Props {
  siteContent: Record<string, string>;
  action?: string;
}

const {
  siteContent: c,
  action = "https://systeme.io/embedded/41620392/subscription",
} = Astro.props;

const title = c.newsletter_title || "5 new tools, every Friday";
const subtitle = c.newsletter_subtitle || "No fluff. No spam. Join 12,000+ builders.";
const placeholder = c.newsletter_placeholder || "your@email.com";
const cta = c.newsletter_cta || "Get the digest";
const label = c.marketing_newsletter_label || "Newsletter";
---

<section
  class="max-w-[1400px] mx-auto px-6 lg:px-12 py-12"
  aria-labelledby="newsletter-heading"
>
  <div
    class="relative bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-4xl p-8 md:p-12 lg:p-16 shadow-md shadow-brand-forest/5 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-forest/8 card-accent-border"
  >

    <div
      class="flex flex-col items-center gap-8"
    >
      <div class="flex-1 text-center">
        <p
          class="inline-flex items-center text-accent-teal border border-accent-teal/20 px-4 py-1.5 text-xs font-bold uppercase tracking-wider rounded-full mb-4"
        >
          {label}
        </p>
        <h2
          id="newsletter-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-forest tracking-tight mb-6"
        >
          {title}
        </h2>
        <p
          class="text-base sm:text-lg text-brand-muted font-medium leading-relaxed"
        >
          {subtitle}
        </p>
      </div>

      <div class="flex-shrink-0">
        <form
          method="post"
          action={action}
          class="flex flex-col sm:flex-row gap-3"
        >
          <input
            class="w-full sm:min-w-[360px] h-12 px-5 border border-brand-forest/10 rounded-full font-sans text-sm font-medium placeholder-gray-400 focus:outline-none focus:border-accent-teal transition-colors"
            type="email"
            name="email"
            placeholder={placeholder}
            required
          />
          <button
            class="h-12 px-6 bg-gradient-cool text-white font-bold uppercase tracking-wider text-xs rounded-full inline-flex items-center justify-center whitespace-nowrap shadow-md shadow-accent-green/20 hover:shadow-lg hover:shadow-accent-green/30 hover:scale-[1.02] transition-all"
            type="submit"
          >
            {cta}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
