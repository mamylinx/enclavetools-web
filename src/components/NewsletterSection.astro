---
interface Props {
  siteContent: Record<string, string>;
  action?: string;
}

const {
  siteContent: c,
  action = "https://systeme.io/embedded/41620392/subscription",
} = Astro.props;

const title = c.newsletter_title || "5 new tools, every Friday";
const subtitle = c.newsletter_subtitle || "No fluff. No spam. Join 12,000+ builders.";
const placeholder = c.newsletter_placeholder || "your@email.com";
const cta = c.newsletter_cta || "Get the digest";
const label = c.marketing_newsletter_label || "Newsletter";
---

<section
  class="max-w-[1400px] mx-auto px-4 md:px-8 py-12"
  aria-labelledby="newsletter-heading"
>
  <div
    class="relative border-2 border-gray-900 bg-gray-50 p-8 md:p-12 lg:p-16 transition-all duration-300 ease-out-expo hover:shadow-card-hover"
  >
    <div
      class="flex flex-col items-center gap-8"
    >
      <div class="flex-1 text-center">
        <p
          class="inline-flex items-center bg-primary-100 text-primary-700 border-2 border-primary-500 px-3 py-1 text-xs font-black uppercase tracking-wider mb-4"
        >
          {label}
        </p>
        <h2
          id="newsletter-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 leading-[1.05] mb-6"
        >
          {title}
        </h2>
        <p
          class="text-base sm:text-lg text-gray-500 font-medium leading-relaxed"
        >
          {subtitle}
        </p>
      </div>

      <div class="flex-shrink-0">
        <form
          method="post"
          action={action}
          class="flex flex-col sm:flex-row gap-3"
        >
          <input
            class="w-full sm:min-w-[360px] h-14 px-4 border-2 border-gray-200 font-sans text-base focus:border-gray-900 focus:ring-2 focus:ring-primary-500 outline-none transition-colors"
            type="email"
            name="email"
            placeholder={placeholder}
            required
          />
          <button
            class="h-14 px-8 bg-gray-900 text-white font-black uppercase tracking-wider text-sm hover:bg-primary-500 transition-colors border-2 border-gray-900 hover:border-primary-500 inline-flex items-center justify-center whitespace-nowrap"
            type="submit"
          >
            {cta}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
