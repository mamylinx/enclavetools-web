---
import siteContent from "../data/site-content.json";

const c = siteContent as Record<string, string>;
---

<footer class="bg-gray-900 text-white py-16 px-4 md:px-8 mt-16">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="md:col-span-1">
        <div class="text-3xl font-black mb-2 tracking-tight text-white">
          Enclavetools
        </div>
        <p class="text-sm font-bold text-gray-400 leading-relaxed">
          {c.footer_tagline || "Your models. Your hardware. Zero subscriptions."}
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <h5 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-2">
          {c.nav_browse || "Browse"}
        </h5>
        <a href="/" class="text-sm font-bold text-gray-300 hover:text-primary-500 transition-colors no-underline"
          >{c.nav_browse || "Browse"}</a
        >
        <a href="/saved" class="text-sm font-bold text-gray-300 hover:text-primary-500 transition-colors no-underline"
          >{c.nav_saved_tools || "Saved tools"}</a
        >
      </div>
      <div class="flex flex-col gap-3">
        <h5 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-2">
          Company
        </h5>
        <a href="https://x.com/MamyLinx" target="_blank" rel="noopener noreferrer"
          class="text-sm font-bold text-gray-300 hover:text-primary-500 transition-colors no-underline"
          >About</a
        >
        <a href="/submit" target="_blank" rel="noopener noreferrer"
          class="text-sm font-bold text-gray-300 hover:text-primary-500 transition-colors no-underline"
          >{c.nav_submit || "Submit a tool"}</a
        >
      </div>
      <div class="flex flex-col gap-3">
        <h5 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-2">
          More
        </h5>
        <a href="/submit" target="_blank" rel="noopener noreferrer"
          class="text-sm font-bold text-gray-300 hover:text-primary-500 transition-colors no-underline"
          >Advertise</a
        >
      </div>
    </div>
    <div class="pt-8 border-t-2 border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-bold text-gray-400">
      <p>{c.footer_copyright || "© 2026 Enclavetools. All rights reserved."}</p>
      <p class="flex items-center gap-3">
        <a href="/privacy" class="text-gray-400 hover:text-white transition-colors no-underline"
          >Privacy Policy</a
        >
        <span class="text-gray-600">·</span>
        <a href="/terms" class="text-gray-400 hover:text-white transition-colors no-underline"
          >Terms</a
        >
      </p>
    </div>
  </div>
</footer>
