---
import siteContent from "../data/site-content.json";

const c = siteContent as Record<string, string>;
---

<footer class="relative bg-brand-footerBg text-white py-16 overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-brand rounded-t-[1px]"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <span
            class="w-8 h-8 bg-gradient-cool rounded-lg flex items-center justify-center shadow-sm shadow-accent-green/30"
          >
            <svg
              class="w-4 h-4 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </span>
          <span class="font-sans font-bold text-2xl text-white"
            >Enclavetools</span
          >
        </div>
        <p class="text-white/60 text-sm leading-relaxed max-w-[220px]">
          {
            c.footer_tagline ||
              "Your models. Your hardware. Zero subscriptions. Manually audited local AI registry."
          }
        </p>
      </div>
      <div>
        <h4
          class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-sans"
        >
          Directory
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/all"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Browse Registry</a>
          </li>
          <li>
            <a
              href="/compare"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Compare tools</a>
          </li>
          <li>
            <a
              href="/stack-builder"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Stack Builder</a>
          </li>
        </ul>
      </div>
      <div>
        <h4
          class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-sans"
        >
          Community
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/submit"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Submit a local tool</a>
          </li>
          <li>
            <a
              href="/about"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >About</a>
          </li>
          <li>
            <a
              href="/blog"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Blog</a>
          </li>
          <li>
            <a
              href="/contact"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Contact</a>
          </li>
        </ul>
      </div>
      <div>
        <h4
          class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-sans"
        >
          Legal
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/privacy"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Privacy Policy</a>
          </li>
<li>
            <a
              href="/terms"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Terms of Service</a
            >
          </li>
          <li>
            <a
              href="/imprint"
              class="text-white/60 text-sm hover:text-white transition-colors"
              >Imprint</a
            >
          </li>
          <li>
            <button
              type="button"
              onclick="window.EnclaveConsent && window.EnclaveConsent.open()"
              class="text-white/60 text-sm hover:text-white transition-colors bg-transparent border-none cursor-pointer p-0 font-[inherit]"
              >Cookie Settings</button
            >
          </li>
        </ul>
      </div>
    </div>
    <div
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-bold text-white/40"
    >
      <p>{c.footer_copyright || "© 2026 Enclavetools. All rights reserved."}</p>
    </div>
  </div>
</footer>
