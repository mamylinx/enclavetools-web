---
interface Props {
  categoryTiles: any[];
  hoverColors: string[];
  tileDescriptions: string[];
  siteContent: Record<string, string>;
}

const {
  categoryTiles,
  hoverColors,
  tileDescriptions,
  siteContent: c,
} = Astro.props;
---

<section
  id="categories"
  class="bg-brand-lightCyan py-20 lg:py-24 border-b border-brand-forest/10"
>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div
      class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12"
    >
      <div class="max-w-xl">
        <p
          class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-2"
        >
          {c.home_category_eyebrow || "Start with the job"}
        </p>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-forest font-sans tracking-tight"
        >
          {c.home_category_heading || "Choose a category."}
        </h2>
      </div>
      <p
        class="text-brand-muted font-medium text-base leading-relaxed max-w-sm lg:mb-2"
      >
        Every tool is cataloged by its specific purpose, making it easy to swap
        external API nodes with self-hosted instances.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        categoryTiles.map((cat: any, index: number) => {
          const accents = ['accent-teal', 'accent-green', 'accent-yellow', 'accent-red'];
          const accent = accents[index % accents.length];
          const accentBg = {
            'accent-teal': 'bg-accent-teal/10 text-accent-teal',
            'accent-green': 'bg-accent-green/10 text-accent-green',
            'accent-yellow': 'bg-accent-yellow/10 text-accent-yellow',
            'accent-red': 'bg-accent-red/10 text-accent-red',
          }[accent];
          return (
            <a
              href={`/${cat.category}`}
              class="flex flex-col h-full bg-white/95 backdrop-blur-sm border border-white/60 p-6 rounded-3xl shadow-sm shadow-brand-forest/5 transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(27,54,27,0.08)] group"
            >
              <div class="flex-1 mb-6">
                <div class="flex justify-between items-start">
                  <span class={`w-10 h-10 rounded-full ${accentBg} flex items-center justify-center text-sm font-bold mb-3`}>
                    {cat.title.charAt(0)}
                  </span>
                  <span class="text-xs text-brand-muted/60 font-medium">
                    {cat.count} {cat.count === 1 ? "Tool" : "Tools"}
                  </span>
                </div>
                <span class="text-lg font-bold text-brand-forest font-sans group-hover:text-accent-teal transition-colors">
                  {cat.title}
                </span>
                <p class="text-xs text-brand-muted mt-2 leading-relaxed">
                  {tileDescriptions[index]}
                </p>
              </div>
              <div class="pt-4 border-t border-brand-forest/5 flex items-center justify-between">
                <span class={`inline-flex px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full ${accentBg}`}>
                  Explore
                </span>
                <span class="text-accent-teal text-base transition-transform group-hover:translate-x-1">
                  →
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
