---
interface Props {
  siteContent: Record<string, string>;
}

const { siteContent: c } = Astro.props;
---

<section
  class="relative py-20 lg:py-24 border-b border-brand-forest/5 text-white overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-cool"></div>
  <div class="absolute inset-0 bg-brand-royalBlue/30"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div>
        <p
          class="text-xs font-bold uppercase tracking-[0.1em] text-white/60 mb-2"
        >
          {c.home_path_eyebrow || "Get Started"}
        </p>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans leading-tight tracking-tight mb-4"
        >
          {c.home_path_heading || "Find the right path for your stack"}
        </h2>
        <p class="text-white/80 text-base max-w-md font-medium leading-relaxed">
          {
            c.home_path_description ||
              "Whether you are replacing an open API, building a clinical dictation framework, or hosting code models locally, we have the tools you need."
          }
        </p>
      </div>
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 lg:justify-end"
      >
        <a
          href="/all"
          class="h-12 px-6 bg-white text-accent-teal hover:bg-brand-bg rounded-full font-bold text-xs uppercase tracking-wider inline-flex items-center justify-center gap-2 shadow-md transition-all duration-200 hover:scale-[1.02]"
        >
          {c.cta_browse_all || "Browse all tools"}
        </a>
        <a
          href="/#use-cases"
          rel="noopener noreferrer"
          class="h-12 px-6 bg-white/15 backdrop-blur-sm hover:bg-white/25 text-white border border-white/20 rounded-full font-bold text-xs uppercase tracking-wider inline-flex items-center justify-center gap-2 shadow-sm transition-all duration-200"
        >
          {c.cta_use_cases || "Find tools from my use cases"}
        </a>
      </div>
    </div>
  </div>
</section>
