---
interface Props {
  eyebrow?: string;
  title?: string;
  tagline?: string;
}

const {
  eyebrow,
  title,
  tagline,
} = Astro.props;
---

<div
  class="bg-brand-cyanBg relative overflow-hidden flex flex-col items-center justify-center py-16 lg:py-24 px-4 md:px-8 border-b border-brand-forest/10"
>
  <header class="max-w-3xl text-center">
    {eyebrow && (
      <p class="inline-flex items-center bg-white text-brand-teal border border-brand-teal/30 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-6">
        {eyebrow}
      </p>
    )}
    {title && (
      <h1 class="hero-headline-inline text-2xl sm:text-5xl lg:text-[4.5rem] font-extrabold text-brand-forest tracking-tight font-sans mb-8">
        {title}
      </h1>
    )}
    {tagline && (
      <p class="font-sans text-brand-forest/90 text-lg lg:text-xl italic leading-relaxed max-w-2xl mx-auto">
        {tagline}
      </p>
    )}
    <slot />
  </header>
</div>
