---
interface Props {
  eyebrow?: string;
  title?: string;
  tagline?: string;
}

const {
  eyebrow,
  title,
  tagline,
} = Astro.props;
---

<div
  class="text-center relative overflow-hidden flex flex-col items-center justify-center py-16 lg:py-24 px-4 md:px-8 border-b-2 border-gray-900"
>
  <header class="max-w-3xl">
    {eyebrow && (
      <p class="inline-flex items-center bg-primary-100 text-primary-700 border-2 border-primary-500 px-3 py-1 text-xs font-black uppercase tracking-wider mb-6 rounded-none">
        {eyebrow}
      </p>
    )}
    {title && (
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 mb-8">
        <strong class="font-black">{title}</strong>
      </h1>
    )}
    {tagline && (
      <p class="text-lg text-gray-500 font-medium leading-relaxed max-w-2xl mx-auto">
        {tagline}
      </p>
    )}
    <slot />
  </header>
</div>
