---

<section class="relative text-white py-20 lg:py-24 border-b border-brand-forest/5 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-brand opacity-85"></div>
  <div class="absolute inset-0 bg-brand-forest/75"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-6 flex flex-col items-start">
          <span class="px-3.5 py-1.5 bg-accent-yellow/90 border border-accent-yellow/20 text-brand-forest text-xs font-bold rounded-full uppercase tracking-wider mb-6 shadow-sm">
          Stack Setup
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans leading-tight tracking-tight mb-6">
          Where new teams launch their AI stack
        </h2>
        <p class="text-white/80 text-base leading-relaxed mb-8 max-w-lg font-medium">
          Build your ideal private stack step-by-step. Compare integration dependencies, deployment files, and hardware targets before compiling repository commands.
        </p>
        <div class="grid grid-cols-2 gap-4 w-full mb-8">
          <div class="bg-white/10 backdrop-blur-sm p-5 border border-white/10 rounded-2xl shadow-sm">
            <p class="text-3xl font-extrabold text-accent-yellow font-sans">—</p>
            <p class="text-xs font-bold uppercase text-white/60 tracking-wider mt-1">Stacks Built by the Community</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-5 border border-white/10 rounded-2xl shadow-sm">
            <p class="text-3xl font-extrabold text-accent-teal font-sans">✓</p>
            <p class="text-xs font-bold uppercase text-white/60 tracking-wider mt-1">Audited for Zero Outbound Leaks</p>
          </div>
        </div>
        <a href="/stack-builder"
          class="h-12 px-6 bg-accent-yellow text-brand-forest rounded-full font-bold text-xs uppercase tracking-wider inline-flex items-center gap-2 shadow-md shadow-accent-yellow/20 hover:shadow-lg hover:shadow-accent-yellow/30 hover:scale-[1.02] transition-all duration-200">
          Open Stack Builder
          <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-[440px] bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-4xl p-6 text-brand-forest shadow-lg shadow-brand-forest/10">
          <div class="bg-brand-tealLight border border-brand-forest/10 h-64 rounded-2xl flex items-center justify-center relative overflow-hidden">
            <svg class="w-3/4 h-3/4" viewBox="0 0 200 200" fill="none" aria-hidden="true">
              <rect x="70" y="140" width="60" height="20" rx="3" fill="#fff" stroke="#111" stroke-width="1.5" />
              <rect x="85" y="50" width="30" height="70" rx="15" fill="#fff" stroke="#111" stroke-width="1.8" />
              <path d="M85 65c0-25 30-25 30 0" fill="#C5F82A" stroke="#111" stroke-width="1.8" />
              <path d="M75 110l10-15v25l-10-10zM125 110l-10-15v25l10-10z" fill="#05B2A3" stroke="#111" stroke-width="1.8" />
            </svg>
          </div>
          <div class="mt-5 p-4 bg-brand-bg border border-brand-forest/10 rounded-xl">
            <p class="text-sm text-brand-muted font-medium leading-relaxed">
              "We replaced three cloud AI API integrations with self-hosted vLLM nodes. Zero outbound customer data leaves our cluster now."
            </p>
            <div class="mt-3 flex items-center gap-2">
              <div class="w-6 h-6 bg-brand-forest text-white text-xs font-bold rounded-full flex items-center justify-center">
                JD
              </div>
              <div>
                <p class="text-sm font-bold text-brand-forest">IT Director</p>
                <p class="text-xs text-brand-muted">Healthcare Infrastructure Group · name withheld for confidentiality</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>