---
interface Props {
  totalTools: number;
  totalCategories: number;
  latestVerified: string;
  siteContent: Record<string, string>;
}

const { totalTools, totalCategories, latestVerified, siteContent: c } = Astro.props;

const formatMonthYear = (dateStr: string) => {
  if (!dateStr) return "Build data";
  return new Date(dateStr).toLocaleDateString("en-US", { month: "short", year: "numeric" });
};
---

<section class="bg-brand-darkGreen py-12 text-white border-b border-brand-forest/10">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-brand-lime font-sans">{totalTools}</p>
        <p class="text-xs text-white/60 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_tools_label || "Verified Local Tools"}</p>
        <span class="trust-badge text-[0.7rem] block text-white/40 font-mono mt-1">manually audited</span>
      </div>
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-white font-sans">{totalCategories}</p>
        <p class="text-xs text-white/60 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_categories_label || "Curated Categories"}</p>
      </div>
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-brand-teal font-sans">{formatMonthYear(latestVerified)}</p>
        <p class="text-xs text-white/60 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_verification_label || "Latest Compliance Audits"}</p>
      </div>
    </div>
  </div>
</section>