---
interface Props {
  totalTools: number;
  totalCategories: number;
  latestVerified: string;
  siteContent: Record<string, string>;
}

const { totalTools, totalCategories, latestVerified, siteContent: c } = Astro.props;

const formatMonthYear = (dateStr: string) => {
  if (!dateStr) return "Build data";
  return new Date(dateStr).toLocaleDateString("en-US", { month: "short", year: "numeric" });
};
---

    <section class="relative py-12 text-white border-b border-brand-forest/10 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-brand opacity-90"></div>
  <div class="absolute inset-0 bg-brand-darkGreen/80"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-white/15">
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-accent-yellow font-sans drop-shadow-sm">{totalTools}</p>
        <p class="text-xs text-white/70 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_tools_label || "Verified Local Tools"}</p>
      </div>
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-white font-sans drop-shadow-sm">{totalCategories}</p>
        <p class="text-xs text-white/70 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_categories_label || "Curated Categories"}</p>
      </div>
      <div class="py-4 md:py-0">
        <p class="text-4xl lg:text-5xl font-extrabold text-accent-teal font-sans drop-shadow-sm">{formatMonthYear(latestVerified)}</p>
        <p class="text-xs text-white/70 uppercase tracking-wider mt-1.5 font-bold">{c.home_stat_verification_label || "Latest Compliance Audits"}</p>
      </div>
    </div>
  </div>
</section>