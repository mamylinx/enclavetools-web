---
interface Props {
  siteContent: Record<string, string>;
}

const { siteContent: c } = Astro.props;
---

<section id="submit-section" class="relative py-20 lg:py-24 border-b border-brand-forest/5 text-brand-forest overflow-hidden">
  <div class="absolute inset-0 bg-linear-to-br from-accent-yellow/40 via-brand-lime/60 to-accent-green/10"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7 flex flex-col items-start">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans leading-tight tracking-tight mb-6">
          {c.home_submit_heading || "List your tool with teams who need privacy"}
        </h2>
        <p class="text-brand-forest/80 text-base leading-relaxed mb-8 max-w-xl font-medium">
          {c.home_submit_description || "Reach developers, healthcare IT managers, legal operations leads, and indie creators actively auditing local software engines."}
        </p>
        <a href="/submit"
          class="h-12 px-6 bg-gradient-cool text-white rounded-full font-bold text-xs uppercase tracking-wider inline-flex items-center justify-center gap-3 shadow-md shadow-accent-green/20 hover:shadow-lg hover:shadow-accent-green/30 hover:scale-[1.02] transition-all duration-200">
          {c.cta_submit_tool || "Submit a tool now"}
          <span>➕</span>
        </a>
      </div>
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="w-full max-w-[400px] bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-4xl p-6 shadow-md shadow-brand-forest/5 text-brand-forest">
          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3 p-3.5 bg-brand-bg/80 backdrop-blur-sm border border-brand-forest/5 rounded-xl shadow-sm">
              <span class="w-6 h-6 text-accent-green text-xs font-bold flex items-center justify-center">✓</span>
              <span class="text-base font-bold font-sans text-brand-forest">Manual License Check</span>
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-brand-bg/80 backdrop-blur-sm border border-brand-forest/5 rounded-xl shadow-sm">
              <span class="w-6 h-6 text-accent-green text-xs font-bold flex items-center justify-center">✓</span>
              <span class="text-base font-bold font-sans text-brand-forest">Verify RAM Threshold limits</span>
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-brand-bg/80 backdrop-blur-sm border border-brand-forest/5 rounded-xl shadow-sm">
              <span class="w-6 h-6 text-accent-green text-xs font-bold flex items-center justify-center">✓</span>
              <span class="text-base font-bold font-sans text-brand-forest">Network Sniffer test (Zero Leakage)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>