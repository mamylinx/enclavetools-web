---
interface Props {
  siteContent: Record<string, string>;
}

const { siteContent: c } = Astro.props;
---

<section class="relative py-20 lg:py-24 border-b border-brand-forest/5 text-brand-forest overflow-hidden">
  <div class="absolute inset-0 bg-linear-to-br from-accent-yellow/8 via-brand-yellowBg to-brand-tealLight/20"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7 flex flex-col items-start">
        <p class="inline-flex items-center bg-white border border-brand-forest/10 text-brand-forest px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm mb-6">
          🖥️ {c.calc_promo_eyebrow || "On-Premises · Offline AI"}
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans leading-tight tracking-tight mb-6">
          {c.calc_promo_heading || "Calculate how much GPU memory your AI needs"}
        </h2>
        <p class="text-brand-forest/80 text-base leading-relaxed mb-8 max-w-xl font-medium">
          {c.calc_promo_copy || "Answer five quick questions — model, context length, users, speed, and GPUs — to see exactly how many cards you need and what they cost to run on your own servers. You set every spec; we assume no prices."}
        </p>
        <a href="/llm-sizing-calculator"
          class="h-12 px-6 bg-gradient-cool text-white rounded-full font-bold text-xs uppercase tracking-wider inline-flex items-center gap-3 shadow-md shadow-accent-green/20 hover:shadow-lg hover:shadow-accent-green/30 hover:scale-[1.02] transition-all duration-200">
          {c.calc_promo_cta || "Open the calculator →"}
        </a>
      </div>
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="w-64 h-80 bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl relative shadow-lg shadow-brand-forest/8 overflow-hidden">
          <div class="absolute inset-0 p-6 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-forest">Enclavetools</span>
              <span class="w-2.5 h-2.5 bg-accent-teal rounded-full"></span>
            </div>
            <div>
              <div class="text-3xl font-extrabold bg-gradient-cool bg-clip-text text-transparent mb-1">≈ 320 GB</div>
              <p class="text-[11px] text-brand-muted font-bold uppercase tracking-wider mb-3">Total GPU memory needed</p>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-sm font-bold text-brand-forest">4× H100 80GB</span>
                <span class="px-2 py-0.5 bg-green-50 text-green-700 border border-green-300 rounded-full text-[10px] font-bold">✓ Enough</span>
              </div>
              <div class="text-sm font-extrabold bg-linear-to-br from-brand-teal to-brand-indigo bg-clip-text text-transparent">≈ — / 1M prompts</div>
              <p class="text-[10px] text-brand-muted mt-1">Your estimate will appear here</p>
            </div>
          </div>
          <div class="absolute left-0 top-0 bottom-0 w-3 bg-brand-forest/10 border-r border-brand-forest/5"></div>
        </div>
      </div>
    </div>
  </div>
</section>
