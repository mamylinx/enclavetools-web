---
interface Props {
  PERSONA: string[];
  featuredTools: any[][];
  filteredCounts: number[];
  filterOptions: any;
  useCaseContent: Record<string, { badge: string; heading: string; description: string; auditFocus: string }>;
  siteContent: Record<string, string>;
}

const { PERSONA, featuredTools, filteredCounts, filterOptions, useCaseContent, siteContent: c } = Astro.props;
---

<section id="use-cases" class="relative py-20 lg:py-24 border-b border-brand-forest/5 text-white overflow-hidden">
  <div class="absolute inset-0 bg-gradient-brand opacity-90"></div>
  <div class="absolute inset-0 bg-brand-deepViolet/70"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent-yellow mb-2">{c.home_usecase_eyebrow || "Use Cases"}</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-sans tracking-tight">{c.home_usecase_heading || "Start from the risk you need to control"}</h2>
    </div>

    <!-- CAROUSEL START -->
    <div class="relative group">
      <div id="use-cases-carousel" class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar pb-4 gap-6">
        {PERSONA.map((p: string, i: number) => {
          const content = useCaseContent[p];
          const label = (filterOptions as any).persona.find((fp: any) => fp.value === p)?.label || p;
          return (
            <div 
              class="w-full lg:min-w-[85%] flex-shrink-0 snap-center bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl p-8 shadow-md shadow-brand-forest/5 flex flex-col justify-between text-brand-forest"
              data-index={i}
            >
              <div>
                <div class="flex items-center gap-2 justify-between mb-4">
                  <span class="text-center inline-flex px-3 py-1 bg-accent-teal/10 border border-accent-teal/20 text-accent-teal text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">{content?.badge || "Infrastructure Curated View"}</span>
                  <span class="text-center text-xs font-bold text-brand-forest/60 bg-brand-forest/5 px-3 py-1 rounded-full">{label}</span>
                </div>
                <h3 class="text-2xl font-bold tracking-tight text-brand-forest mb-4 font-sans">{content?.heading || p}</h3>
                <p class="text-brand-muted text-base leading-relaxed mb-6 font-medium">{content?.description || ""}</p>

                {
                  featuredTools[i]?.length ? (
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
                      {featuredTools[i].slice(0, 8).map((tool: any) => (
                        <a
                          href={`/tools/${tool.slug}`}
                           class="p-4 bg-brand-bg/80 backdrop-blur-sm border border-brand-forest/5 rounded-xl group transition-all hover:-translate-y-1 hover:shadow-md flex items-center justify-between"
                        >
                          <strong class="text-sm font-bold text-brand-forest group-hover:text-brand-teal transition-colors">
                            {tool.title}
                          </strong>
                          <svg class="w-4 h-4 text-brand-forest/40 group-hover:text-brand-teal transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      ))}
                    </div>
                  ) : null
                }

                <div class="p-4 bg-brand-bg border border-brand-forest/10 rounded-xl">
                  <p class="text-xs font-extrabold text-brand-teal uppercase tracking-[0.1em] mb-1">Audit Metric Focus</p>
                  <p class="text-base font-medium text-brand-forest">{content?.auditFocus || "—"}</p>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-brand-forest/10 flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-xs font-bold uppercase tracking-wider text-brand-muted">Filter tags are pre-applied for this view</p>
                 <a href={`/all?persona=${encodeURIComponent(p)}`} class="text-xs font-bold text-accent-teal uppercase tracking-wider hover:underline flex items-center gap-1.5 font-sans transition-colors">
                  Browse this view
                  <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Indicators -->
      <div class="flex justify-center items-center gap-3 mt-8">
        {PERSONA.map((_, i) => (
          <button
            class="carousel-indicator w-3 h-3 rounded-full transition-all duration-300 bg-white/30 hover:bg-white/60 focus:outline-none focus:ring-2 focus:ring-white/50"
            data-index={i}
            aria-label={`Go to slide ${i + 1}`}
          ></button>
        ))}
      </div>
      
      <!-- Navigation Arrows -->
      <button id="carousel-prev" class="absolute left-[-20px] top-1/2 -translate-y-1/2 bg-white hover:bg-gray-50 text-brand-forest p-3 rounded-full shadow-md transition-all hidden lg:block opacity-0 group-hover:opacity-100 z-10" aria-label="Previous Slide">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="carousel-next" class="absolute right-[-20px] top-1/2 -translate-y-1/2 bg-white hover:bg-gray-50 text-brand-forest p-3 rounded-full shadow-md transition-all hidden lg:block opacity-0 group-hover:opacity-100 z-10" aria-label="Next Slide">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .carousel-indicator.active {
    background-color: white;
    transform: scale(1.2);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const carousel = document.getElementById('use-cases-carousel');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    
    if (!carousel) return;

    const updateIndicators = () => {
      // Calculate which slide is most visible
      const scrollLeft = carousel.scrollLeft;
      const itemWidth = carousel.clientWidth; // or use a more precise calculation based on children
      const index = Math.round(scrollLeft / itemWidth);
      
      indicators.forEach((ind, i) => {
        if (i === index) {
          ind.classList.add('active');
        } else {
          ind.classList.remove('active');
        }
      });
    };

    carousel.addEventListener('scroll', updateIndicators);
    
    // Initial update
    updateIndicators();

    indicators.forEach((ind, i) => {
      ind.addEventListener('click', () => {
        const firstChild = carousel.firstElementChild as HTMLElement;
        const itemWidth = firstChild ? firstChild.offsetWidth + 24 : carousel.clientWidth; // 24 is gap-6
        carousel.scrollTo({
          left: itemWidth * i,
          behavior: 'smooth'
        });
      });
    });

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const firstChild = carousel.firstElementChild as HTMLElement;
        const itemWidth = firstChild ? firstChild.offsetWidth + 24 : carousel.clientWidth;
        carousel.scrollBy({ left: -itemWidth, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        const firstChild = carousel.firstElementChild as HTMLElement;
        const itemWidth = firstChild ? firstChild.offsetWidth + 24 : carousel.clientWidth;
        carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
      });
    }
  });
</script>