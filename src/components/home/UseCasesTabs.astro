---
interface Props {
  PERSONA: string[];
  featuredTools: any[][];
  filteredCounts: number[];
  filterOptions: any;
  useCaseContent: Record<string, { badge: string; heading: string; description: string; auditFocus: string }>;
  siteContent: Record<string, string>;
}

const { PERSONA, featuredTools, filteredCounts, filterOptions, useCaseContent, siteContent: c } = Astro.props;
---

<section id="use-cases" class="relative py-20 lg:py-24 border-b border-brand-forest/5 text-white overflow-hidden">
  <div class="absolute inset-0 bg-gradient-brand opacity-90"></div>
  <div class="absolute inset-0 bg-brand-deepViolet/70"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent-yellow mb-2">{c.home_usecase_eyebrow || "Use Cases"}</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-sans tracking-tight">{c.home_usecase_heading || "Start from the risk you need to control"}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-4 flex flex-col gap-3.5" role="tablist" aria-label="Use case options">
        {PERSONA.map((p: string, i: number) => {
          const label = (filterOptions as any).persona.find((fp: any) => fp.value === p)?.label || p;
          return (
            <button
              id={`tab-${p.replace(/\s+/g, "-").toLowerCase()}`}
              data-persona={p}
              data-tab-role="tab"
              class={`w-full text-left p-5 rounded-2xl font-bold text-base shadow-sm transition-all duration-200 focus:outline-none ${
                i === 0
                  ? "bg-gradient-cool text-white border-transparent shadow-md shadow-accent-green/20"
                  : "bg-white text-brand-forest border border-brand-forest/5 hover:bg-accent-teal/5"
              }`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`use-case-${p.replace(/\s+/g, "-").toLowerCase()}`}
            >
              {label}
            </button>
          );
        })}
      </div>

      <div class="lg:col-span-8 bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl p-8 shadow-md shadow-brand-forest/5 min-h-[350px] flex flex-col justify-between text-brand-forest">
        {PERSONA.map((p: string, i: number) => {
          const content = useCaseContent[p];
          const panelId = `use-case-${p.replace(/\s+/g, "-").toLowerCase()}`;
          return (
            <div id={panelId}
              class={`use-case-content ${i === 0 ? "" : "hidden"}`}
              role="tabpanel"
              aria-labelledby={`tab-${p.replace(/\s+/g, "-").toLowerCase()}`}
            >
              <span class="inline-flex px-3 py-1 bg-accent-teal/10 border border-accent-teal/20 text-accent-teal text-xs font-bold uppercase tracking-wider rounded-full mb-4 shadow-sm">{content?.badge || "Infrastructure Curated View"}</span>
              <h3 class="text-2xl font-bold tracking-tight text-brand-forest mb-4 font-sans">{content?.heading || p}</h3>
              <p class="text-brand-muted text-base leading-relaxed mb-6 font-medium">{content?.description || ""}</p>

              {
                featuredTools[i]?.length ? (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    {featuredTools[i].slice(0, 4).map((tool: any) => (
                      <a
                        href={`/tools/${tool.slug}`}
                         class="p-4 bg-brand-bg/80 backdrop-blur-sm border border-brand-forest/5 rounded-xl group transition-all hover:-translate-y-1 hover:shadow-md"
                      >
                        <strong class="text-sm font-bold text-brand-forest group-hover:text-brand-teal transition-colors">
                          {tool.title}
                        </strong>
                        <span class="text-xs text-brand-muted mt-1 line-clamp-2">
                          {tool.body}
                        </span>
                      </a>
                    ))}
                  </div>
                ) : null
              }

              <div class="p-4 bg-brand-bg border border-brand-forest/10 rounded-xl">
                <p class="text-xs font-extrabold text-brand-teal uppercase tracking-[0.1em] mb-1">Audit Metric Focus</p>
                <p class="text-base font-medium text-brand-forest">{content?.auditFocus || "—"}</p>
              </div>
            </div>
          );
        })}

        <div class="mt-8 pt-6 border-t border-brand-forest/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs font-bold uppercase tracking-wider text-brand-muted">Filter tags are pre-applied for this view</p>
               <a href="/all" class="text-xs font-bold text-accent-teal uppercase tracking-wider hover:underline flex items-center gap-1.5 font-sans transition-colors">
            Browse this view
            <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/scripts/use-case-tabs.js" defer></script>