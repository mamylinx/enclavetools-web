---
interface Props {
  category: string;
  categoryTitle: string;
  enrichedTool: any;
}

const { category, categoryTitle, enrichedTool } = Astro.props;
---

<nav class="flex gap-2 text-xs font-bold mb-6 text-brand-muted">
  <a href="/" class="text-brand-forest hover:text-brand-teal transition-colors"
    >Home</a
  ><span>/</span
  ><a
    href={`/${category}`}
    class="text-brand-forest hover:text-brand-teal transition-colors"
    >{categoryTitle}</a
  ><span>/</span><span>{enrichedTool.title}</span>
</nav>
