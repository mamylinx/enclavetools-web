---
const { category, toolName, calculatorModel } = Astro.props;
const modelKey = calculatorModel || toolName;

if (category !== "llm-models") {
  return null;
}
---

<div
  class="relative bg-linear-to-br from-accent-yellow/12 via-white to-accent-teal/8 backdrop-blur-sm border border-accent-yellow/25 p-6 md:p-8 rounded-3xl shadow-sm shadow-brand-forest/5"
>
  <div class="absolute -top-4 -right-2 text-4xl drop-shadow-md">🧮</div>
  <h3 class="text-xl font-extrabold text-brand-forest mb-2">
    Planning to deploy {toolName}?
  </h3>
  <p class="text-brand-muted mb-4">
    Estimate exact GPU VRAM requirements, context limits, fine-tuning memory, and infrastructure costs for <strong>{toolName}</strong> before committing to hardware.
  </p>
  <a
    href={`/llm-sizing-calculator?model=${encodeURIComponent(modelKey)}`}
    class="inline-flex items-center justify-center text-center bg-gradient-cool text-white font-bold px-6 py-3 rounded-full hover:shadow-lg hover:shadow-accent-green/30 hover:scale-[1.02] transition-all shadow-md shadow-accent-green/20"
  >
    Calculate Hardware & GPU Sizing →
  </a>
</div>
