---
const { category, toolName } = Astro.props;

if (category !== "llm-models") {
  return null;
}
---

<div
  class="bg-amber-50 border-2 border-amber-200 p-6 md:p-8 rounded-2xl relative shadow-sm"
>
  <div class="absolute -top-4 -right-2 text-4xl drop-shadow-md">🧮</div>
  <h3 class="text-xl font-extrabold text-brand-forest mb-2">
    Deploying {toolName} in production?
  </h3>
  <p class="text-brand-muted mb-4">
    Stop guessing hardware deployment. Get our <strong>Hardware Certainty Blueprint</strong> for <strong>{toolName}</strong> — validated hardware estimates, and cost projections before you commit to infrastructure.
  </p>
  <a
    href={`/privacy-offer?tool=${encodeURIComponent(toolName)}&env=On-Prem%20Server`}
    class="inline-flex items-center justify-center text-center bg-brand-forest text-white font-bold px-6 py-3 rounded-full hover:bg-brand-teal transition-colors shadow-sm"
  >
    Request Hardware Sizing Audit
  </a>
</div>
