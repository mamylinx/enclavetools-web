---
interface Props {
  enrichedTool: any;
  canonicalUrl: string;
}

const { enrichedTool, canonicalUrl } = Astro.props;
---

<section id="setup" class="py-12 border-b border-brand-forest/10">
  <p class="text-xs font-bold uppercase mb-4 text-brand-muted tracking-wider">
    Setup &amp; Installation
  </p>
  <div class="grid grid-cols-1 gap-6">
    <div class="bg-white border border-brand-forest/10 rounded-3xl p-6">
      <span
        class={`inline-block w-3 h-3 rounded-full mr-2 ${String(enrichedTool.setup_difficulty).toLowerCase() === "low" ? "bg-green-600" : String(enrichedTool.setup_difficulty).toLowerCase() === "high" ? "bg-red-500" : "bg-yellow-400"}`}
      ></span><strong class="font-bold text-lg"
        >{enrichedTool.setup_difficulty}</strong
      ><p class="text-sm leading-relaxed text-brand-forest/80 mt-2">
        {
          enrichedTool.setup_difficulty === "Low"
            ? "GUI, low-resource, or simple install path likely available."
            : enrichedTool.setup_difficulty === "High"
              ? "Expect GPU, framework, or production deployment work."
              : "A developer can usually get this running with standard docs."
        }
      </p>
    </div>
  </div>
  <pre
    class="border border-brand-forest/10 p-6 overflow-x-auto mt-4 text-sm bg-brand-bg rounded-3xl"><code>{`# Start with the official project repository\n# ${enrichedTool.github_url || enrichedTool.url || canonicalUrl}`}</code></pre>
</section>
