---
interface Props {
  enrichedTool: any;
  canonicalUrl: string;
}

const { enrichedTool, canonicalUrl } = Astro.props;
---

<section id="setup" class="py-12 border-b border-brand-forest/5">
  <p class="text-xs font-bold uppercase mb-4 text-brand-muted tracking-wider">
    Setup &amp; Installation
  </p>
  <div class="grid grid-cols-1 gap-6">
    <div class="bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl p-6 shadow-sm shadow-brand-forest/5 transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(27,54,27,0.08)]">
      <span
        class={`inline-block w-3 h-3 rounded-full mr-2 ${String(enrichedTool.setup_difficulty).toLowerCase() === "low" ? "bg-accent-green" : String(enrichedTool.setup_difficulty).toLowerCase() === "high" ? "bg-accent-red" : "bg-accent-yellow"}`}
      ></span><strong class="font-bold text-lg"
        >{enrichedTool.setup_difficulty}</strong
      ><p class="text-sm leading-relaxed text-brand-forest/80 mt-2">
        {
          enrichedTool.setup_difficulty === "Low"
            ? "GUI, low-resource, or simple install path likely available."
            : enrichedTool.setup_difficulty === "High"
              ? "Expect GPU, framework, or production deployment work."
              : "A developer can usually get this running with standard docs."
        }
      </p>
    </div>
  </div>
  <pre
    class="border border-brand-forest/5 p-6 overflow-x-auto mt-4 text-sm bg-linear-to-br from-brand-tealLight/30 to-brand-bg rounded-3xl shadow-sm shadow-brand-forest/5"><code>{`# Start with the official project repository\n# ${enrichedTool.github_url || enrichedTool.url || canonicalUrl}`}</code></pre>
</section>
