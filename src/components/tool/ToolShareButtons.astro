---
interface Props {
  xShareUrl: string;
  linkedinShareUrl: string;
}

const { xShareUrl, linkedinShareUrl } = Astro.props;
---

<div class="flex gap-3 pt-8 font-bold">
  <a
    href={xShareUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="border border-brand-forest/5 bg-white/90 backdrop-blur-sm text-brand-forest px-6 h-12 font-bold cursor-pointer hover:bg-accent-teal hover:text-white hover:border-accent-teal transition-all no-underline text-sm inline-flex items-center rounded-full hover:shadow-md"
    >Share on X</a
  >
  <a
    href={linkedinShareUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="border border-brand-forest/5 bg-white/90 backdrop-blur-sm text-brand-forest px-6 h-12 font-bold cursor-pointer hover:bg-accent-teal hover:text-white hover:border-accent-teal transition-all no-underline text-sm inline-flex items-center rounded-full hover:shadow-md"
    >Share on LinkedIn</a
  >
</div>
