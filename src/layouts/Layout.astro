---
import SeoHead from "../components/SeoHead.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/home/Hero.astro";
import CategoryNav from "../components/CategoryNav.vue";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/main.css";

export interface Props {
  site?: string;
  title: string;
  tagline: string;
  pageTitle?: string;
  pageDescription?: string;
  canonicalUrl?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: string;
  ogSiteName?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  pageFavicon?: string;
  showSearch?: boolean;
  searchPlaceholder?: string;
  showHero?: boolean;
  eyebrow?: string;
}

const {
  title,
  tagline,
  showHero = false,
  eyebrow,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SeoHead {...seoProps} />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>

  <body class="bg-brand-bg font-sans text-brand-forest antialiased text-base">
    <NavHeader showSearch={seoProps.showSearch} searchPlaceholder={seoProps.searchPlaceholder} />
    <CategoryNav client:load />

    {showHero && <Hero eyebrow={eyebrow} title={title} tagline={tagline} />}

    <main id="main-content" class="w-full">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<script src="/scripts/layout.js" defer></script>
