---
import SeoHead from "../components/SeoHead.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/home/Hero.astro";
import CategoryNav from "../components/CategoryNav.vue";
import SiteFooter from "../components/SiteFooter.astro";
import CookieBanner from "../components/CookieBanner.vue";
import { ClientRouter } from "astro:transitions";
import "../styles/main.css";

export interface Props {
  site?: string;
  title: string;
  tagline: string;
  pageTitle?: string;
  pageDescription?: string;
  canonicalUrl?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: string;
  ogSiteName?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  pageFavicon?: string;
  showSearch?: boolean;
  searchPlaceholder?: string;
  showHero?: boolean;
  showNav?: boolean;
  showFooter?: boolean;
  eyebrow?: string;
}

const {
  title,
  tagline,
  showHero = false,
  showNav = true,
  showFooter = true,
  eyebrow,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <SeoHead {...seoProps} />
    <ClientRouter />
    <script type="partytown" src="https://www.googletagmanager.com/gtag/js?id=G-S9K7BBRYW1"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="/scripts/cookie-consent.js" defer></script>
  </head>

  <body class="bg-gradient-to-br from-brand-bg via-white to-brand-tealLight/30 font-sans text-brand-forest antialiased text-base min-h-screen">
    {showNav && (
      <>
        <NavHeader showSearch={seoProps.showSearch} searchPlaceholder={seoProps.searchPlaceholder} />
        <CategoryNav client:load />
      </>
    )}

    {showHero && <Hero eyebrow={eyebrow} title={title} tagline={tagline} />}

    <main id="main-content" class="w-full">
      <slot />
    </main>

    {showFooter && <SiteFooter />}
    <CookieBanner client:load />
  </body>
</html>

<script src="/scripts/layout.js" defer></script>
