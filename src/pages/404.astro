---
import Layout from "../layouts/Layout.astro";
---

<Layout
  site="404 Page Not Found - Enclavetools"
  title="Oops!"
  tagline="We can't seem to find the page you're looking for. Error code: 404"
>
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center p-8">
    <div class="flex gap-4 items-center">
      <a href="https://enclavetools.com" class="inline-flex items-center min-h-[48px] border-2 border-gray-900 px-6 font-extrabold bg-gray-900 text-white hover:bg-primary-600 transition-colors no-underline shadow-[4px_4px_0_0_rgba(17,24,39,1)] hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_rgba(17,24,39,1)]" tabindex="0"
        >Back to Home</a
      >
    </div>
  </div>
</Layout>
