---
import Layout from "../layouts/Layout.astro";
---

<Layout
  site="404 Page Not Found - Enclavetools"
  title="Oops!"
  tagline="We can't seem to find the page you're looking for. Error code: 404"
>
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center p-8">
    <div class="flex gap-4 items-center">
      <a href="https://enclavetools.com" class="inline-flex items-center min-h-[48px] bg-gray-900 text-white px-6 font-extrabold hover:bg-primary-500 transition-colors no-underline border-2 border-gray-900 hover:border-primary-500" tabindex="0"
        >Back to Home</a
      >
    </div>
  </div>
</Layout>
