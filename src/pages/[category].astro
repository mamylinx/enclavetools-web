---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import toolsData from "../data/tools.json";
import categories from "../data/categories.json";
const categoryMap = Object.fromEntries(categories.map(c => [c.category, c.title]));

export function getStaticPaths() {
  return toolsData.tools.map((cat: any) => ({
    params: { category: cat.category }
  }));
}

const { category } = Astro.params;
const categoryData = toolsData.tools.find((cat: any) => cat.category === category);
const categoryTitle = categoryData?.title ?? category;
const ssrTools = (categoryData?.content || []).map((tool: any) => ({
  ...tool,
  category: [category],
}));
---
<Layout
    site={`Enclavetools - ${categoryTitle}`}
    title="Enclavetools"
    tagline="Stop paying for AI APIs. Everything here runs on your hardware."
    showSearch={true}
    searchPlaceholder={`Search in ${categoryTitle}...`}
>
    <ItemListSchema items={ssrTools} listName={`${categoryTitle} Tools`} />
    <BreadcrumbSchema items={[
      { name: "Home", url: "https://enclavetools.mamyrkt.xyz" },
      { name: categoryTitle },
    ]} />
    <Dashboard
        client:load
        category={category}
        transition:persist
        ssr-tools={ssrTools}
        ssr-total={ssrTools.length}
    />
</Layout>
