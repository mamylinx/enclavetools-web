---
import Layout from "../../layouts/Layout.astro";
import Dashboard from "../../components/Dashboard.vue";
import ItemListSchema from "../../components/schema/ItemListSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import toolsData from "../../data/tools.json";

export function getStaticPaths({ paginate }: any) {
    const categories = toolsData.tools.map((cat: any) => cat.category);
    categories.push("all");

    return categories.flatMap((category: string) => {
        let tools;
        if (category === "all") {
            tools = toolsData.tools.flatMap((cat: any) =>
                cat.content.map((tool: any) => ({
                    ...tool,
                    category: [cat.category],
                })),
            );
        } else {
            const catData = toolsData.tools.find(
                (cat: any) => cat.category === category,
            );
            tools = (catData?.content || []).map((tool: any) => ({
                ...tool,
                category: [category],
            }));
        }

        return paginate(tools, {
            params: { category },
            pageSize: 25,
        });
    });
}

const { category } = Astro.params;
const { page } = Astro.props as { page: any };

let categoryTitle = category;
if (category === "all") {
    categoryTitle = "All Tools";
} else {
    const categoryData = toolsData.tools.find(
        (cat: any) => cat.category === category,
    );
    categoryTitle = categoryData?.title ?? category;
}

const tools = page.data;
---

<Layout
    site={`Enclavetools - ${categoryTitle}`}
    title="Enclavetools"
    tagline="Stop paying for AI APIs. Everything here runs on your hardware."
    pageTitle={`${categoryTitle} AI Tools`}
    pageDescription={`Browse ${categoryTitle} AI tools — self-hosted, private, and local alternatives to cloud AI APIs.`}
    showSearch={true}
>
    <ItemListSchema items={tools} listName={`${categoryTitle} Tools`} />
    <BreadcrumbSchema
        items={[
            { name: "Home", url: "https://enclavetools.com" },
            { name: categoryTitle },
        ]}
    />
    <Dashboard
        client:visible
        category={category}
        transition:persist
        ssr-tools={tools}
        ssr-total={page.total}
    />

    <div id="ssr-pagination"
        class="flex justify-center items-center gap-3 py-12 px-4 md:px-8 border-t-2 border-gray-900 max-w-[1400px] mx-auto"
    >
        {
            page.url.prev ? (
                <a
                    href={page.url.prev}
                    class="inline-flex items-center h-12 px-4 border-2 border-gray-900 text-xs font-black uppercase tracking-wider text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-200 no-underline"
                >
                    ← Previous
                </a>
            ) : null
        }
        <span class="px-4 text-xs font-black uppercase tracking-wider text-gray-500">Page {page.currentPage} of {page.lastPage}</span
        >
        {
            page.url.next ? (
                <a
                    href={page.url.next}
                    class="inline-flex items-center h-12 px-4 border-2 border-gray-900 text-xs font-black uppercase tracking-wider text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-200 no-underline"
                >
                    Next
                    <svg class="w-4 h-4 ml-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </a>
            ) : null
        }
    </div>
</Layout>
