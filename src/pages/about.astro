---
import Layout from "../layouts/Layout.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import AuthorSchema from "../components/schema/AuthorSchema.astro";

const breadcrumbs = [
    { name: "Home", url: "https://enclavetools.com" },
    { name: "About" },
];
---

<Layout
    site="Enclavetools"
    title="About"
    tagline="Your AI. Your hardware. Your data. No APIs. No surveillance."
    pageTitle="About — Enclavetools"
    pageDescription="Learn about Enclavetools — the curated directory of self-hosted AI tools that run on your hardware. Our mission, vision, and the story behind the project."
    keywords={[
        "self-hosted AI",
        "privacy-first AI",
        "local AI tools",
        "no API keys",
        "data leakage",
        "offline AI",
        "AI due diligence",
        "self-hosted AI directory",
    ]}
    articleAuthor="Mamy Rakotomalala"
    articlePublishedTime="2025-07-22T00:00:00Z"
>
    <BreadcrumbSchema items={breadcrumbs} />
    <AuthorSchema
        name="Mamy Rakotomalala"
        url="https://enclavetools.com/about"
        affiliation="Enclavetools"
        description="Founder and lead auditor at Enclavetools. Over a decade of experience in infrastructure engineering and AI systems. Started Enclavetools after discovering how much sensitive data closed-source AI vendors silently collect."
        sameAs={[
            "https://github.com/mamylinx",
            "https://x.com/MamyLinx",
        ]}
    />

    <!-- HERO: Simple -->
    <section
        class="bg-brand-cyanBg relative overflow-hidden border-b border-brand-forest/10"
    >
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-20 lg:py-28">
            <div class="max-w-3xl mx-auto text-center">
                <p
                    class="inline-flex items-center bg-white text-brand-teal border border-brand-teal/30 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-6"
                >
                    The Mission
                </p>
                <h1
                    class="text-3xl sm:text-5xl lg:text-[4.5rem] font-extrabold text-brand-forest tracking-tight font-sans mb-6"
                >
                    Self-Hosted AI.<br />
                    <span class="text-brand-teal">Full Control.</span> Zero Leakage.
                </h1>
                <p
                    class="font-sans text-brand-forest/80 text-lg lg:text-xl max-w-2xl mx-auto"
                >
                    Enclavetools is the curated directory of private AI tools
                    that run on your own hardware. No API keys. No surveillance.
                    No vendor lock-in.
                </p>
            </div>
        </div>
    </section>

    <!-- THE PROBLEM: Unexpected -->
    <section class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center"
            >
                <div class="lg:col-span-5">
                    <p
                        class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3"
                    >
                        The Hidden Cost
                    </p>
                    <h2
                        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-6"
                    >
                        Every "Free" AI Service<br />
                        <span class="text-brand-muted">Has a Hidden Cost</span>
                    </h2>
                </div>
                <div class="lg:col-span-7">
                    <div class="space-y-6">
                        <p
                            class="text-base sm:text-lg text-brand-forest/80 font-medium"
                        >
                            Every time you use an AI API, you're trading
                            something more valuable than money: your data, your
                            independence, and your security.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div
                                class="bg-white border border-red-200/50 rounded-2xl p-5 shadow-sm"
                            >
                                <span
                                    class="text-xl font-bold text-red-500 block mb-1"
                                    >Data Leakage</span
                                >
                                <p class="text-sm text-brand-muted">
                                    Your prompts, code, and proprietary
                                    documents train the next model.
                                </p>
                            </div>
                            <div
                                class="bg-white border border-red-200/50 rounded-2xl p-5 shadow-sm"
                            >
                                <span
                                    class="text-xl font-bold text-red-500 block mb-1"
                                    >Vendor Lock-In</span
                                >
                                <p class="text-sm text-brand-muted">
                                    Pricing changes overnight. Models deprecate.
                                    Features disappear.
                                </p>
                            </div>
                            <div
                                class="bg-white border border-red-200/50 rounded-2xl p-5 shadow-sm"
                            >
                                <span
                                    class="text-xl font-bold text-red-500 block mb-1"
                                    >Rate Limits</span
                                >
                                <p class="text-sm text-brand-muted">
                                    You're capped, throttled, and queued behind
                                    paying customers.
                                </p>
                            </div>
                            <div
                                class="bg-white border border-red-200/50 rounded-2xl p-5 shadow-sm"
                            >
                                <span
                                    class="text-xl font-bold text-red-500 block mb-1"
                                    >Privacy Theater</span
                                >
                                <p class="text-sm text-brand-muted">
                                    "Enterprise security" still means your data
                                    touches someone else's server.
                                </p>
                            </div>
                        </div>
                        <p
                            class="text-base sm:text-lg font-bold text-brand-forest mt-2"
                        >
                            The AI industry built a beautiful prison. The walls
                            are convenience. The guards are API keys. And you're
                            paying for the privilege of being locked in.
                        </p>
                        <p class="text-xl font-bold text-brand-teal">
                            It doesn't have to be this way.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- THE SOLUTION: Simple -->
    <section
        class="bg-brand-forest text-white py-20 lg:py-24 border-b border-brand-forest/10"
    >
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <div class="max-w-3xl mb-14">
                <p
                    class="text-xs font-bold uppercase tracking-[0.1em] text-brand-lime mb-3"
                >
                    The Solution
                </p>
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4"
                >
                    Your AI Stack.<br />
                    <span class="text-brand-teal">Your Hardware.</span> Your Rules.
                </h2>
                <p class="text-white/80 text-base sm:text-lg font-medium">
                    Enclavetools is the definitive directory of self-hosted AI
                    tools — software that runs entirely on your own
                    infrastructure. Every tool listed here is screened by coding
                    agent, and verified by a human before it goes live.
                </p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <div
                    class="bg-white/10 border border-white/10 rounded-3xl p-6 backdrop-blur-sm"
                >
                    <span
                        class="w-10 h-10 bg-brand-teal/20 border border-brand-teal/30 rounded-xl flex items-center justify-center text-brand-teal text-lg font-bold mb-4"
                        >1</span
                    >
                    <h3 class="font-bold text-lg mb-2">Runs Locally</h3>
                    <p class="text-white/60 text-sm">
                        On your laptop, your server, or your Raspberry Pi
                        cluster. No cloud required.
                    </p>
                </div>
                <div
                    class="bg-white/10 border border-white/10 rounded-3xl p-6 backdrop-blur-sm"
                >
                    <span
                        class="w-10 h-10 bg-brand-teal/20 border border-brand-teal/30 rounded-xl flex items-center justify-center text-brand-teal text-lg font-bold mb-4"
                        >2</span
                    >
                    <h3 class="font-bold text-lg mb-2">No API Keys</h3>
                    <p class="text-white/60 text-sm">
                        Zero monthly bills. Zero per-token pricing. Pay for your
                        hardware once.
                    </p>
                </div>
                <div
                    class="bg-white/10 border border-white/10 rounded-3xl p-6 backdrop-blur-sm"
                >
                    <span
                        class="w-10 h-10 bg-brand-teal/20 border border-brand-teal/30 rounded-xl flex items-center justify-center text-brand-teal text-lg font-bold mb-4"
                        >3</span
                    >
                    <h3 class="font-bold text-lg mb-2">Data Stays Yours</h3>
                    <p class="text-white/60 text-sm">
                        Zero telemetry. Zero outbound data leakage. Verified by
                        packet-sniffer audits.
                    </p>
                </div>
                <div
                    class="bg-white/10 border border-white/10 rounded-3xl p-6 backdrop-blur-sm"
                >
                    <span
                        class="w-10 h-10 bg-brand-teal/20 border border-brand-teal/30 rounded-xl flex items-center justify-center text-brand-teal text-lg font-bold mb-4"
                        >4</span
                    >
                    <h3 class="font-bold text-lg mb-2">Yours Forever</h3>
                    <p class="text-white/60 text-sm">
                        No deprecation. No sunset. No enshittification. The
                        software can't be taken from you.
                    </p>
                </div>
            </div>
            <blockquote
                class="border-l-4 border-brand-teal/50 pl-6 py-2 mt-10 text-white/60 italic text-sm sm:text-base max-w-2xl leading-relaxed"
            >
                "It was 3 AM during a production outage when I dug into our
                network traffic and realized just how much sensitive user data
                our closed-source AI vendors were scraping off our calls. That
                night, I stopped trusting closed models. I started building what
                I wished existed: a directory of privacy-first, local-capable AI
                tools that answer to no one but you."
            </blockquote>
        </div>
    </section>

    <!-- FOUNDER BIO -->
    <section class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
                <div class="lg:col-span-4">
                    <div class="w-24 h-24 bg-brand-tealLight border border-brand-teal/20 rounded-3xl flex items-center justify-center text-4xl font-extrabold text-brand-teal">
                        MR
                    </div>
                </div>
                <div class="lg:col-span-8">
                    <p class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3">
                        The Founder
                    </p>
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-4">
                        Mamy Rakotomalala
                    </h2>
                    <p class="text-brand-forest/80 text-base sm:text-lg font-medium mb-4">
                        Infrastructure engineer and AI privacy advocate. After years of building ML systems on cloud APIs, I dug into our network traffic during a production outage and discovered how much sensitive user data closed-source AI vendors silently scrape. That moment changed everything.
                    </p>
                    <p class="text-brand-forest/80 text-base font-medium mb-6">
                        I started Enclavetools to build a directory of AI tools that answer to no one but you. Every tool is manually audited — not because we trust code, but because we don't trust anything we haven't verified.
                    </p>
                    <div class="flex flex-wrap gap-4 text-sm font-bold">
                        <a href="https://github.com/mamylinx" class="text-brand-teal hover:text-brand-forest transition-colors" target="_blank" rel="noopener noreferrer">GitHub →</a>
                        <a href="https://x.com/MamyLinx" class="text-brand-teal hover:text-brand-forest transition-colors" target="_blank" rel="noopener noreferrer">X →</a>
                        <a href="mailto:mamy.else@gmail.com" class="text-brand-teal hover:text-brand-forest transition-colors">Email →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- THE DIRECTORY: Concrete -->
    <section class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 gap-12 items-center mb-14">
                <div class="lg:col-span-5">
                    <p
                        class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3"
                    >
                        The Directory
                    </p>
                    <h2
                        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-4"
                    >
                        Automated Static Discovery,<br />
                        <span class="text-brand-teal">Human Verification,</span>
                        Deep audits on demand.
                    </h2>
                    <p class="text-brand-forest/80 text-base font-medium">
                        A coding agent statically reviews the source of every
                        candidate — dependencies, telemetry SDKs, outbound-call
                        patterns, license terms — before it's shortlisted. A
                        human resolves the edge cases before anything goes live.
                    </p>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mt-10">
                <!-- Listed & Verified -->
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-8 md:p-10 shadow-sm flex flex-col"
                >
                    <span
                        class="inline-flex items-center bg-white text-brand-teal border border-brand-teal/30 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-5 w-fit"
                    >
                        Listed &amp; Verified
                    </span>
                    <h3 class="text-2xl font-extrabold text-brand-forest mb-3">
                        Every tool, by default
                    </h3>
                    <p class="text-brand-forest/80 text-base font-medium mb-6">
                        What a code-level read can confirm, for all 163+ tools,
                        at no cost to you.
                    </p>
                    <ul class="space-y-3 mb-8 flex-1">
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            License &amp; commercial-use check
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Dependency &amp; known-tracker scan
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Docs claims vs. code diff
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Declared hardware requirements
                        </li>
                    </ul>
                    <!-- <div
                        class="pt-6 border-t border-brand-forest/10"
                    >
                        <span
                            class="text-brand-teal font-bold text-sm"
                            >Included with every listing</span
                        >
                    </div> -->
                </div>

                <!-- Deep Audited -->
                <div
                    class="bg-brand-cyanBg border border-brand-teal/20 rounded-3xl p-8 md:p-10 shadow-sm flex flex-col"
                >
                    <span
                        class="inline-flex items-center bg-brand-teal text-white px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-5 w-fit"
                    >
                        &#9670; Deep Audited
                    </span>
                    <h3 class="text-2xl font-extrabold text-brand-forest mb-3">
                        On request, per tool
                    </h3>
                    <p class="text-brand-forest/80 text-base font-medium mb-6">
                        The tool is actually installed and run, with real
                        traffic captured — for teams who need certainty, not
                        just a first read.
                    </p>
                    <ul class="space-y-3 mb-8 flex-1">
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Full runtime network capture
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Every endpoint classified &amp; documented
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Measured benchmarks on real hardware
                        </li>
                        <li
                            class="flex items-start gap-3 text-sm text-brand-forest/80"
                        >
                            <span class="text-brand-teal mt-0.5 shrink-0"
                                >&#10003;</span
                            >
                            Report published back to the tool page
                        </li>
                    </ul>
                    <div class="pt-6 border-t border-brand-teal/20">
                        <span class="text-brand-teal font-bold text-sm"
                            >Request a deep audit for any tool</span
                        >
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-10">
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-6 md:p-8 shadow-sm"
                >
                    <div
                        class="w-10 h-10 bg-brand-tealLight border border-brand-teal/20 rounded-xl flex items-center justify-center text-brand-teal text-lg mb-4"
                    >
                        &#x1F50D;
                    </div>
                    <h3 class="font-bold text-xl text-brand-forest mb-2">
                        Plain-English Overview
                    </h3>
                    <p class="text-sm text-brand-muted">
                        What the tool actually does, who it's for, and when
                        you'd use it — not marketing copy.
                    </p>
                </div>
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-6 md:p-8 shadow-sm"
                >
                    <div
                        class="w-10 h-10 bg-brand-tealLight border border-brand-teal/20 rounded-xl flex items-center justify-center text-brand-teal text-lg mb-4"
                    >
                        &#x1F4CB;
                    </div>
                    <h3 class="font-bold text-xl text-brand-forest mb-2">
                        Technical Scorecard
                    </h3>
                    <p class="text-sm text-brand-muted">
                        License safety, commercial use, API support,
                        fine-tuning, quantization, Docker, GUI, telemetry, and
                        offline capability — scored and compared.
                    </p>
                </div>
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-6 md:p-8 shadow-sm"
                >
                    <div
                        class="w-10 h-10 bg-brand-tealLight border border-brand-teal/20 rounded-xl flex items-center justify-center text-brand-teal text-lg mb-4"
                    >
                        &#x2699;&#xFE0F;
                    </div>
                    <h3 class="font-bold text-xl text-brand-forest mb-2">
                        Hardware &amp; Setup
                    </h3>
                    <p class="text-sm text-brand-muted">
                        RAM, GPU, architecture, and setup difficulty — from Plug
                        &amp; Play to Advanced — so you know before you clone.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- THE METHODOLOGY -->
    <section
        class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10"
        id="methodology"
    >
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <div class="max-w-3xl mx-auto text-center mb-14">
                <p
                    class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3"
                >
                    The Methodology
                </p>
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-4"
                >
                    4 Stages of<br />
                    <span class="text-brand-teal">Due Diligence.</span>
                </h2>
                <p
                    class="text-brand-forest/80 text-base sm:text-lg font-medium"
                >
                    Every tool passes through the same four-stage pipeline
                    before it's published. No listing goes live without
                    evidence.
                </p>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mt-10">
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-8 md:p-10 shadow-sm"
                >
                    <span
                        class="inline-flex items-center bg-brand-teal/10 text-brand-teal border border-brand-teal/20 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-5 w-fit"
                    >
                        Stage 1
                    </span>
                    <h3 class="text-xl font-extrabold text-brand-forest mb-3">
                        Discover + Scan
                    </h3>
<p class="text-brand-forest/80 text-base font-medium mb-5">
                            Mining GitHub Topics, HuggingFace Hub, and community sources for candidates. Automated license scan via <a href="https://github.com/nexB/scancode-toolkit" class="text-brand-teal hover:underline" target="_blank" rel="noopener noreferrer">ScanCode</a> + <a href="https://www.foossology.org/" class="text-brand-teal hover:underline" target="_blank" rel="noopener noreferrer">FOSSology</a>.
                        </p>
                    <div class="flex flex-wrap gap-2">
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >GitHub API</span
                        >
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >HuggingFace</span
                        >
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >ScanCode</span
                        >
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >FOSSology</span
                        >
                    </div>
                </div>
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-8 md:p-10 shadow-sm"
                >
                    <span
                        class="inline-flex items-center bg-brand-teal/10 text-brand-teal border border-brand-teal/20 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-5 w-fit"
                    >
                        Stage 2
                    </span>
                    <h3 class="text-xl font-extrabold text-brand-forest mb-3">
                        Static Code Review
                    </h3>
<p class="text-brand-forest/80 text-base font-medium mb-5">
                            A coding agent reads the source tree via the <a href="https://docs.github.com/en/rest" class="text-brand-teal hover:underline" target="_blank" rel="noopener noreferrer">GitHub API</a>: dependency tree, known telemetry/analytics SDKs, outbound-call patterns, and how the code's behavior compares to what the docs claim. Unresolved cases are flagged for human review.
                        </p>
                    <div class="flex flex-wrap gap-2">
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >Static Analysis</span
                        >
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >Dependency Tree</span
                        >
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-brand-forest/5 border border-brand-forest/10 rounded-full text-brand-forest/70"
                            >Claim vs. Code</span
                        >
                    </div>
                </div>
                <div
                    class="bg-white border border-brand-forest/10 rounded-3xl p-8 md:p-10 shadow-sm"
                >
                    <span
                        class="inline-flex items-center bg-brand-teal/10 text-brand-teal border border-brand-teal/20 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] mb-5 w-fit"
                    >
                        Stage 3
                    </span>
                    <h3 class="text-xl font-extrabold text-brand-forest mb-3">
                        Declared Requirements Check
                    </h3>
<p class="text-brand-forest/80 text-base font-medium mb-5">
