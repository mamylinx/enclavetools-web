---
import Layout from "../layouts/Layout.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import AuthorSchema from "../components/schema/AuthorSchema.astro";
import AboutHero from "../components/about/AboutHero.astro";
import ProblemSection from "../components/about/ProblemSection.astro";
import SolutionSection from "../components/about/SolutionSection.astro";
import FounderBio from "../components/about/FounderBio.astro";
import DirectorySection from "../components/about/DirectorySection.astro";
import MethodologySection from "../components/about/MethodologySection.astro";
import GoDeeperSection from "../components/about/GoDeeperSection.astro";
import WhyItMattersSection from "../components/about/WhyItMattersSection.astro";
import VisionSection from "../components/about/VisionSection.astro";
import CTASection from "../components/about/CTASection.astro";
import AuditModal from "../components/about/AuditModal.astro";

const breadcrumbs = [
    { name: "Home", url: "https://enclavetools.com" },
    { name: "About" },
];
---

<Layout
    site="Enclavetools"
    title="About"
    tagline="Your AI. Your hardware. Your data. No APIs. No surveillance."
    pageTitle="About — Enclavetools"
    pageDescription="Learn about Enclavetools — the curated directory of self-hosted AI tools that run on your hardware. Our mission, vision, and the story behind the project."
    keywords={[
        "self-hosted AI",
        "privacy-first AI",
        "local AI tools",
        "no API keys",
        "data leakage",
        "offline AI",
        "AI due diligence",
        "self-hosted AI directory",
    ]}
    articleAuthor="Mamy Rakotomalala"
    articlePublishedTime="2025-07-22T00:00:00Z"
>
    <BreadcrumbSchema items={breadcrumbs} />
    <AuthorSchema
        name="Mamy Rakotomalala"
        url="https://enclavetools.com/about"
        affiliation="Enclavetools"
        description="Founder and lead auditor at Enclavetools. Over a decade of experience in infrastructure engineering and AI systems. Started Enclavetools after discovering how much sensitive data closed-source AI vendors silently collect."
        sameAs={["https://github.com/mamylinx", "https://t.me/Mamylinx"]}
    />

    <AboutHero />
    <ProblemSection />
    <SolutionSection />
    <FounderBio />
    <DirectorySection />
    <MethodologySection />
    <GoDeeperSection />
    <WhyItMattersSection />
    <VisionSection />
    <CTASection />
    <AuditModal />
</Layout>
