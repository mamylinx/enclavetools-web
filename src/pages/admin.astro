---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AdminPanel from '../components/AdminPanel.vue';

// Very basic server-side check to see if they might be logged in. 
// The real validation is done in the API.
const session = Astro.cookies.get('admin_session');
const isLoggedIn = !!session?.value;
---

<Layout title="Admin Panel | Enclavetools">
  <main class="block max-w-[800px] mx-auto pt-10 px-4 md:px-0">
    <div class="text-left mb-6">
      <h1 class="text-4xl font-black text-gray-900 uppercase tracking-tight">
        Admin Dashboard
      </h1>
    </div>

    <AdminPanel client:only="vue" :initial-logged-in="isLoggedIn" />
  </main>
</Layout>
