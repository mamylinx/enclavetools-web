---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import AdminPanel from "../components/AdminPanel.vue";

// Very basic server-side check to see if they might be logged in.
// The real validation is done in the API.
const session = Astro.cookies.get("admin_session");
const isLoggedIn = !!session?.value;
---

<Layout
  site="Enclavetools - Admin"
  title="Dashboard"
  tagline="Admin Dashboard for Enclavetools"
  eyebrow="Administration"
  pageTitle="Admin Dashboard"
  pageDescription="Admin Dashboard for Enclavetools - Manage tools, categories, and site content."
  showSearch={true}
  showHero={true}
>
    <div class="block max-w-[1400px] mx-auto pt-10 px-4 md:px-0">
      <AdminPanel client:only="vue" initialLoggedIn={isLoggedIn} />
    </div>
  </Layout>
</Layout>
