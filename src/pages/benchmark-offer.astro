---
import Layout from "../layouts/Layout.astro";
---

<Layout
  site="Enclavetools - AI Hardware Sizing & Benchmark Data"
  title="Server Certainty Blueprint | Stop Guessing Hardware"
  tagline="Get custom LLM sizing and benchmark data before you waste thousands on the wrong GPUs."
  pageTitle="Custom LLM Hardware Sizing & Benchmarks"
  pageDescription="Don't buy expensive GPUs based on guesses. Get precise hardware sizing and performance benchmarks tailored to your exact AI model and workload."
  canonicalUrl="https://enclavetools.com/benchmark-offer"
  showSearch={false}
>
  <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16">
    <div id="app">
      <!-- HEADER -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-brand-forest tracking-tight mb-6 leading-tight text-center md:text-left">
        Stop Guessing Hardware for <span class="text-brand-teal" id="displayModel">Your AI</span>.<br>
        Before It Costs You <span class="text-amber-500">Thousands</span>.
      </h1>

      <div class="text-lg md:text-xl text-brand-muted border-l-4 border-amber-500 pl-5 mb-8 font-medium" id="subheadline">
        You need <strong class="text-brand-forest" id="displayInTok">4,000</strong> input tokens → <strong class="text-brand-forest" id="displayOutTok">500</strong> output tokens, 
        serving <strong class="text-brand-forest" id="displayUsers">10</strong> concurrent users at <strong class="text-brand-forest" id="displayRPS">1</strong> RPS.
      </div>

      <!-- SPEC BADGE GRID -->
      <div class="flex flex-wrap gap-3 bg-brand-forest/5 p-5 md:p-6 rounded-2xl mb-10 border border-brand-forest/10" id="specGrid">
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">🧠 Model: <span class="text-brand-forest font-bold" id="badgeModel">Qwen2.5-7B</span></div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">⚙️ Params: <span class="text-brand-forest font-bold" id="badgeParams">7B</span></div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">🎯 Precision: <span class="text-brand-forest font-bold" id="badgePrecision">FP32</span></div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">📥 Input: <span class="text-brand-forest font-bold" id="badgeInTok">4k</span> tokens</div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">📤 Output: <span class="text-brand-forest font-bold" id="badgeOutTok">500</span></div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">👥 Users: <span class="text-brand-forest font-bold" id="badgeUsers">10</span></div>
        <div class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm">⚡ Mode: <span class="text-brand-forest font-bold" id="badgeMode">Inference</span></div>
        <div class="bg-brand-forest text-white px-4 py-2 rounded-full text-sm font-bold shadow-sm">💾 Est. VRAM: <span class="text-amber-400" id="badgeVram">~29.5 GB</span></div>
      </div>

      <!-- AGITATION -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">The <span class="text-amber-500">Brutal Truth</span> About Your Server Stack</h2>
      <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-xl my-6">
        <p class="text-lg text-red-900 mb-3">
          <strong id="agitationModel">Qwen2.5-7B</strong> in <strong id="agitationPrecision">FP32</strong> requires ~<span id="agitationVram">28</span>GB just for weights. 
          Add your KV cache (<span id="agitationTokens">4,500</span> total tokens) and suddenly your "simple" GPU math is out the window. 
        </p>
        <p class="text-red-800">
          But here is the trap: <strong>VRAM is half the battle.</strong> If you pair that card with slow PCIe lanes, 
          insufficient CPU cores, or thermal throttling, your <span id="agitationModel2">Qwen2.5-7B</span> will 
          choke at <span id="agitationUsers">10</span> concurrent users—and your latency will spike past 30 seconds.
        </p>
      </div>

      <p class="text-lg text-brand-muted font-medium mb-4 mt-6">
        Guess wrong on the <em>complete</em> system, and you either:
      </p>
      <ul class="list-disc pl-8 mb-8 text-lg text-brand-muted space-y-3">
        <li><strong class="text-red-600">Over-provision:</strong> Waste <strong>$50k–$100k</strong> on unused cores, excess rack space, and inflated power bills.</li>
        <li><strong class="text-red-600">Under-provision:</strong> Your server 503s, SLAs breach, and your enterprise client churns within the month.</li>
      </ul>

      <!-- OFFER -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-2">The <span class="text-amber-500">Complete Server Certainty</span> Blueprint</h2>
      <p class="text-brand-muted mb-6 text-lg">
        Custom-built for <strong class="text-brand-forest" id="offerModel">Qwen2.5-7B</strong> at <strong class="text-brand-forest" id="offerUsers">10</strong> concurrent users. 
        No generic forum posts. Just data.
      </p>

      <div class="grid grid-cols-1 gap-4 my-8">
        <div class="flex items-start gap-4 bg-brand-forest/5 p-5 rounded-xl border border-brand-forest/10 hover:border-amber-500 transition-colors">
          <div class="bg-amber-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5">1</div>
          <div class="text-brand-muted"><strong class="text-brand-forest">Full-Stack Benchmark Report</strong> — Real tokens/sec measured on 3 complete server builds (entry, balanced, overkill) under YOUR exact <span id="offerInTok">4k</span>/<span id="offerOutTok">500</span> token load.</div>
        </div>
        <div class="flex items-start gap-4 bg-brand-forest/5 p-5 rounded-xl border border-brand-forest/10 hover:border-amber-500 transition-colors">
          <div class="bg-amber-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5">2</div>
          <div class="text-brand-muted"><strong class="text-brand-forest">Exact Bill of Materials (BOM)</strong> — Specific make/model for motherboard, CPU SKU, RAM sticks, NVMe drives, PSU, and chassis. Zero ambiguity.</div>
        </div>
        <div class="flex items-start gap-4 bg-brand-forest/5 p-5 rounded-xl border border-brand-forest/10 hover:border-amber-500 transition-colors">
          <div class="bg-amber-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5">3</div>
          <div class="text-brand-muted"><strong class="text-brand-forest">"No-Bottleneck" YAML Config</strong> — NUMA-node tuned, kernel-optimized, and ready to deploy. Hits max throughput on your specific hardware.</div>
        </div>
        <div class="flex items-start gap-4 bg-brand-forest/5 p-5 rounded-xl border border-brand-forest/10 hover:border-amber-500 transition-colors">
          <div class="bg-amber-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5">4</div>
          <div class="text-brand-muted"><strong class="text-brand-forest">3-Year TCO Comparison</strong> — Dell/Supermicro pre-built vs. whitebox vs. cloud. We show you exactly where to save <strong>$40k+</strong> in opex.</div>
        </div>
        <div class="flex items-start gap-4 bg-brand-forest/5 p-5 rounded-xl border border-brand-forest/10 hover:border-amber-500 transition-colors">
          <div class="bg-amber-500 text-white font-bold text-sm w-7 h-7 rounded-full flex items-center justify-center shrink-0 mt-0.5">5</div>
          <div class="text-brand-muted"><strong class="text-brand-forest">BONUS: Rack & Cooling Diagram</strong> — Thermal dissipation and 1U/2U layouts so your facilities team approves it instantly. (Value: $750)</div>
        </div>
      </div>

      <!-- SOCIAL PROOF -->
      <div class="bg-brand-forest/5 border border-brand-forest/10 p-6 md:p-8 rounded-2xl my-8 italic text-brand-muted relative">
        <div class="absolute text-8xl text-amber-500/20 -top-4 left-4 font-serif">"</div>
        <p class="relative z-10 text-lg">
          We were quoted <strong>$110k</strong> for a pre-built AI server for our <strong>Llama 3</strong> workload. 
          This blueprint showed us a dual-EPYC build with an A6000 Ada gave us 85% of the performance for 60% of the cost—and actually fit our power budget.
        </p>
        <span class="block mt-4 font-semibold text-brand-teal not-italic">— Head of Infrastructure, Fortune 500 Logistics Firm</span>
      </div>

      <!-- GUARANTEE -->
      <div class="bg-amber-50 border-2 border-dashed border-amber-500 rounded-2xl p-6 md:p-8 my-10">
        <h3 class="text-amber-700 text-xl font-bold mb-3">🛡️ The "Pre-Flight Validation" Guarantee</h3>
        <p class="text-brand-muted mb-4">
          We stand by our engineering <strong>100%</strong>—but we will not accept liability for variables we cannot control (BIOS versions, thermal installation, or third-party dependencies).
          <br><br>
          Here is exactly how we protect you <em>and</em> ourselves:
        </p>
        
        <div class="grid gap-4 mt-4 bg-white p-5 rounded-xl border-l-4 border-amber-500 shadow-sm">
          <div class="flex gap-3 items-start">
            <span class="text-amber-500 font-extrabold text-lg">①</span>
            <div class="text-brand-muted"><strong class="text-brand-forest">Pre-Purchase Order Review:</strong> Before you swipe your PO, we review your exact shopping cart. If we spot a mismatched motherboard, wrong RAM speed, or under-specced PSU, we <strong>halt the order</strong> and correct it. We guarantee the <em>design</em> is flawless before a single cent is spent.</div>
          </div>
          <div class="flex gap-3 items-start mt-2">
            <span class="text-amber-500 font-extrabold text-lg">②</span>
            <div class="text-brand-muted"><strong class="text-brand-forest">The "Gold Master" Check:</strong> We require a <strong>15-minute screen-share pre-flight call</strong> before you go live. We verify your BIOS settings, driver versions, and kernel parameters against our tested environment. If we approve it, the benchmark <em>will</em> hit our projected numbers.</div>
          </div>
        </div>

        <hr class="border-amber-200 my-6">

        <p class="text-brand-forest font-medium">
          <strong class="text-amber-600">✅ Our Clause:</strong> 
          You complete steps ① and ② above, deploy the exact hardware we designed, and we miss the tokens-per-second target—<strong>we refund 100% of the blueprint fee</strong>. No debate. No fine print.
        </p>
        
        <p class="text-amber-800/70 text-sm mt-4 italic">
          ⚠️ <strong>Important:</strong> If you skip the Pre-Purchase Review or the Pre-Flight Call, our guarantee converts to a <strong>"Best-Effort Advisory"</strong>. We will still support you via email, but we cannot guarantee performance outcomes on unverified installations. We do this to keep our prices low and our data honest.
        </p>
      </div>

      <!-- SCARCITY -->
      <div class="text-center my-8">
        <div class="bg-red-50 text-red-700 px-6 py-3 rounded-full inline-block font-bold border border-red-200 shadow-sm">
          ⚠️ Only <span id="slotCount">4</span> Slots Available This Week
        </div>
        <p class="text-brand-muted text-sm mt-3">
          Full-system benchmarking costs us <strong>$400+ in compute rentals</strong> per client. We cap it at <span id="slotCount2">4</span> to keep the data accurate.
        </p>
      </div>

      <!-- CTA -->
      <div class="text-center mb-8">
        <a href="/contact" id="contactCtaBtn" class="btn-primary block w-full md:w-auto md:inline-block text-xl font-bold px-8 py-5 shadow-xl hover:scale-105 transition-transform text-center mx-auto">
          ✅ YES – Secure My Slot. Send My Full-Server Benchmark.
        </a>
        <p class="text-brand-muted text-sm mt-4">Takes 90 seconds to fill out your specs. No sales call required.</p>
      </div>

      <!-- PS -->
      <div class="border-t border-brand-forest/10 pt-8 mt-10 text-brand-muted">
        <strong class="text-amber-600">P.S.</strong> Still on the fence? The cost of inaction: You order a pre-configured "AI Server", hit a PCIe bottleneck in month 4, and burn <strong>$15k</strong> in engineer overtime fixing it. 
        That headache alone costs more than this blueprint. <span class="font-bold text-brand-forest" id="psSlots">4 slots</span> left. Lock yours in now.
      </div>
      
    </div>
  </div>

  <script>
    (function() {
      // --- 1. PARSE URL PARAMETERS ---
      const params = new URLSearchParams(window.location.search);
      const dataParam = params.get('d');
      
      let state = {};
      if (dataParam) {
        try {
          state = JSON.parse(decodeURIComponent(atob(dataParam)));
        } catch (e) {
          console.error("Failed to parse data");
        }
      }
      
      const model = state.model || params.get('model') || 'Qwen2.5-7B';
      const paramsB = state.params || params.get('params') || '7';
      const precision = state.precision || params.get('precision') || 'FP32';
      const inTok = parseInt(state.inTok || params.get('inTok')) || 4000;
      const outTok = parseInt(state.outTok || params.get('outTok')) || 500;
      const users = parseInt(state.users || params.get('users')) || 10;
      const rps = parseFloat(state.rps || params.get('rps')) || 1.0;
      const ttft = parseFloat(state.ttft || params.get('ttft')) || 2.0;
      const ttlt = parseFloat(state.ttlt || params.get('ttlt')) || 30.0;
      const mode = state.mode || params.get('mode') || 'inference';

      // --- 2. CALCULATE ESTIMATED VRAM ---
      let bytesPerParam = 4; // default FP32
      if (precision.toUpperCase() === 'FP16' || precision.toUpperCase() === 'BF16') bytesPerParam = 2;
      else if (precision.toUpperCase().includes('INT8') || precision.toUpperCase() === 'FP8') bytesPerParam = 1;
      else if (precision.toUpperCase() === 'INT4') bytesPerParam = 0.5;
      
      const weightGB = (parseFloat(paramsB) * bytesPerParam) / 1.024; // GiB approx
      const totalTokens = inTok + outTok;
      const kvGB = (totalTokens / 1000) * (parseFloat(paramsB) / 1) * 0.15; 
      const totalVramGB = (weightGB + kvGB + 0.5).toFixed(1); 
      
      const formatNum = (num) => num.toLocaleString();
      const inTokDisplay = formatNum(inTok);
      const outTokDisplay = formatNum(outTok);
      const totalTokDisplay = formatNum(totalTokens);

      // --- 3. POPULATE THE HTML DYNAMICALLY ---
      document.getElementById('displayModel').textContent = model;
      document.getElementById('subheadline').innerHTML = 
        `You need <strong class="text-brand-forest">${inTokDisplay}</strong> input tokens → <strong class="text-brand-forest">${outTokDisplay}</strong> output tokens, serving <strong class="text-brand-forest">${users}</strong> concurrent users at <strong class="text-brand-forest">${rps}</strong> RPS.`;

      document.getElementById('badgeModel').textContent = model;
      document.getElementById('badgeParams').textContent = `${paramsB}B`;
      document.getElementById('badgePrecision').textContent = precision;
      document.getElementById('badgeInTok').textContent = `${inTokDisplay}`;
      document.getElementById('badgeOutTok').textContent = outTokDisplay;
      document.getElementById('badgeUsers').textContent = users;
      document.getElementById('badgeMode').textContent = mode.charAt(0).toUpperCase() + mode.slice(1);
      document.getElementById('badgeVram').textContent = `~${totalVramGB} GB`;

      document.getElementById('agitationModel').textContent = model;
      document.getElementById('agitationPrecision').textContent = precision;
      document.getElementById('agitationVram').textContent = weightGB.toFixed(1);
      document.getElementById('agitationTokens').textContent = totalTokDisplay;
      document.getElementById('agitationModel2').textContent = model;
      document.getElementById('agitationUsers').textContent = users;

      document.getElementById('offerModel').textContent = model;
      document.getElementById('offerUsers').textContent = users;
      document.getElementById('offerInTok').textContent = inTokDisplay;
      document.getElementById('offerOutTok').textContent = outTokDisplay;

      // Scarcity slots
      const slots = 4;
      document.getElementById('slotCount').textContent = slots;
      document.getElementById('slotCount2').textContent = slots;
      document.getElementById('psSlots').textContent = `${slots} slots`;

      // --- 4. DYNAMIC CTA LINK ---
      let bodyText = `Hi, I'm interested in the Custom LLM Hardware Sizing & Benchmark Data.\n\nHere is my calculator session data:\n`;
      bodyText += `- Model: ${model}\n`;
      bodyText += `- Params: ${paramsB}B\n`;
      bodyText += `- Precision: ${precision}\n`;
      bodyText += `- Input Tokens: ${inTok}\n`;
      bodyText += `- Output Tokens: ${outTok}\n`;
      bodyText += `- Peak Concurrent Users: ${users}\n`;
      bodyText += `- Average RPS: ${rps}\n`;
      bodyText += `- Max TTFT: ${ttft}s\n`;
      bodyText += `- Max TTLT: ${ttlt}s\n`;
      bodyText += `- Mode: ${mode}\n`;
      bodyText += `- Est. VRAM: ~${totalVramGB} GB\n`;

      const ctaBtn = document.getElementById('contactCtaBtn');
      if (ctaBtn) {
        ctaBtn.setAttribute('href', `/contact?subject=Hardware%20Sizing%20%26%20Benchmark&body=${encodeURIComponent(bodyText)}`);
      }
    })();
  </script>
</Layout>
