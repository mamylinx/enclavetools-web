---
import Layout from "../../layouts/Layout.astro";
import SeoHead from "../../components/SeoHead.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }: any) {
    const posts = await getCollection("blog");
    posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props as { page: any };
const posts = page.data;
---

<Layout
    site="Enclavetools"
    title="Blog"
    tagline="Insights on self-hosted AI, privacy, and due diligence"
    pageTitle={page.currentPage > 1 ? `Blog — Page ${page.currentPage} — Enclavetools` : "Blog — Enclavetools"}
    pageDescription="Articles on self-hosted AI, privacy-first infrastructure, and practical guidance for auditing your AI tools."
    keywords={["self-hosted AI blog", "AI privacy", "AI due diligence", "telemetry auditing", "local AI"]}
    articleAuthor="Mamy Rakotomalala"
>
    <SeoHead
        pageTitle={page.currentPage > 1 ? `Blog — Page ${page.currentPage}` : "Blog"}
        pageDescription="Articles on self-hosted AI, privacy-first infrastructure, and practical guidance for auditing your AI tools."
        keywords={["self-hosted AI blog", "AI privacy", "AI due diligence", "telemetry auditing", "local AI"]}
        articleAuthor="Mamy Rakotomalala"
    />

    <section class="relative py-20 lg:py-24 border-b border-brand-forest/5 overflow-hidden">
        <div class="absolute inset-0 bg-linear-to-br from-brand-tealLight/30 via-brand-bg to-accent-yellow/5"></div>
        <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
            <div class="max-w-3xl mx-auto text-center mb-14">
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-4">
                    Practical AI Privacy &amp; Infrastructure Guidance
                </h1>
                <p class="text-brand-forest/80 text-base sm:text-lg font-medium">
                    Deep dives into self-hosted AI, telemetry auditing, and due diligence — from the engineers who verify every tool listed on the directory.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
                {posts.map((post: any) => (
                    <a
                        href={`/blog/${post.id}`}
                        class="bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl p-8 md:p-10 shadow-sm shadow-brand-forest/5 hover:border-accent-teal/20 hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(27,54,27,0.08)] transition-all duration-200 block no-underline group"
                    >
                        <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent-teal mb-3">
                            {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                        </p>
                        <h2 class="text-xl font-extrabold text-brand-forest mb-3">
                            {post.data.title}
                        </h2>
                        <p class="text-brand-forest/80 text-base font-medium">
                            {post.data.description}
                        </p>
                        <span class="inline-flex items-center text-accent-teal text-sm font-bold mt-4 group-hover:gap-1 transition-all">
                            Read more →
                        </span>
                    </a>
                ))}
            </div>

            {page.lastPage > 1 && (
                <div id="ssr-pagination"
                    class="flex justify-center items-center gap-3 mt-16 pt-12 border-t border-brand-forest/5"
                >
                    {page.url.prev && <link rel="prev" href={`https://enclavetools.com${page.url.prev}`} />}
                    {page.url.next && <link rel="next" href={`https://enclavetools.com${page.url.next}`} />}
                    {
                        page.url.prev ? (
                            <a
                                href={page.url.prev}
                                class="inline-flex items-center h-12 px-6 bg-white/90 backdrop-blur-sm border border-brand-forest/5 text-xs font-bold uppercase tracking-wider text-brand-forest hover:bg-gradient-cool hover:text-white hover:border-transparent hover:shadow-md hover:shadow-accent-green/20 transition-all duration-200 no-underline rounded-full"
                            >
                                ← Previous
                            </a>
                        ) : null
                    }
                    <span class="px-4 text-xs font-bold uppercase tracking-wider text-brand-muted">Page {page.currentPage} of {page.lastPage}</span>
                    {
                        page.url.next ? (
                            <a
                                href={page.url.next}
                                class="inline-flex items-center h-12 px-6 bg-white/90 backdrop-blur-sm border border-brand-forest/5 text-xs font-bold uppercase tracking-wider text-brand-forest hover:bg-gradient-cool hover:text-white hover:border-transparent hover:shadow-md hover:shadow-accent-green/20 transition-all duration-200 no-underline rounded-full"
                            >
                                Next
                                <svg class="w-4 h-4 ml-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                  <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        ) : null
                    }
                </div>
            )}
        </div>
    </section>
</Layout>
