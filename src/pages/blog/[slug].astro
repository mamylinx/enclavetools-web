---
import Layout from "../../layouts/Layout.astro";
import SeoHead from "../../components/SeoHead.astro";
import path from "path";
import fs from "fs";
import { getStaticPaths } from "astro";

const blogDir = path.join(process.cwd(), "src", "content", "blog");

export async function getStaticPaths() {
    const files = fs.readdirSync(blogDir).filter((f) => f.endsWith(".md"));
    return files.map((file) => {
        const slug = file.replace(".md", "");
        return { params: { slug } };
    });
}

const { slug } = Astro.params;
const filePath = path.join(blogDir, `${slug}.md`);
const fileContent = fs.readFileSync(filePath, "utf-8");

const frontmatterMatch = fileContent.match(/^---\n([\s\S]*?)\n---/);
let frontmatter: Record<string, string> = {};
let body = "";

if (frontmatterMatch) {
    frontmatterMatch[1].split("\n").forEach((line) => {
        const match = line.match(/^(\w+):\s*(.+)$/);
        if (match) {
            let key = match[1];
            let val = match[2].trim();
            if (val.startsWith('"') && val.endsWith('"')) val = val.slice(1, -1);
            frontmatter[key] = val;
        }
    });
    body = fileContent.slice(frontmatterMatch[0].length).trim();
}

const title = frontmatter.title || slug;
const description = frontmatter.description || "";
const date = frontmatter.date || "";
const author = frontmatter.author || "Mamy Rakotomalala";
---

<Layout
    site="Enclavetools"
    title={title}
    tagline={description}
    pageTitle={`${title} — Enclavetools Blog`}
    pageDescription={description}
    keywords={["self-hosted AI", "AI privacy", "telemetry auditing", "AI infrastructure"]}
    articleAuthor={author}
>
    <SeoHead
        pageTitle={title}
        pageDescription={description}
        keywords={["self-hosted AI", "AI privacy", "telemetry auditing", "AI infrastructure"]}
        articleAuthor={author}
        articlePublishedTime={date ? new Date(date).toISOString() : "2026-07-22T00:00:00Z"}
        ogType="article"
    />

    <section class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <article class="max-w-3xl mx-auto">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3">
                    {new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-6">
                    {title}
                </h1>
                <p class="text-brand-teal text-sm font-bold mb-8">
                    By {author}
                </p>
                <div class="text-brand-forest/80 text-base sm:text-lg font-medium leading-relaxed" set:html={body} />
            </article>
        </div>
    </section>
</Layout>