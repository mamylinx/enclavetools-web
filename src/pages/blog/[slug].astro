---
import Layout from "../../layouts/Layout.astro";
import SeoHead from "../../components/SeoHead.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author } = post.data;
---

<Layout
    site="Enclavetools"
    title={title}
    tagline={description}
    pageTitle={`${title} — Enclavetools Blog`}
    pageDescription={description}
    keywords={["self-hosted AI", "AI privacy", "telemetry auditing", "AI infrastructure"]}
    articleAuthor={author}
>
    <SeoHead
        pageTitle={title}
        pageDescription={description}
        keywords={["self-hosted AI", "AI privacy", "telemetry auditing", "AI infrastructure"]}
        articleAuthor={author}
        articlePublishedTime={date ? date.toISOString() : "2026-07-22T00:00:00Z"}
        ogType="article"
    />

    <section class="bg-brand-bg py-20 lg:py-24 border-b border-brand-forest/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            <article class="max-w-3xl mx-auto">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-brand-teal mb-3">
                    {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-forest tracking-tight mb-6">
                    {title}
                </h1>
                <p class="text-brand-teal text-sm font-bold mb-8">
                    By {author}
                </p>
                <div class="text-brand-forest/80 text-base sm:text-lg font-medium leading-relaxed prose prose-brand max-w-none">
                    <Content />
                </div>
            </article>
        </div>
    </section>
</Layout>