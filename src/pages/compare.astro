---
import Layout from "../layouts/Layout.astro";
import CompareView from "../components/CompareView.vue";
import toolsData from "../data/tools.json";

const allTools = toolsData.tools.flatMap((cat: any) =>
  cat.content.map((tool: any) => ({
    ...tool,
    category: cat.category,
  })),
);
---

<Layout
  site="Enclavetools - Compare"
  title="Side-by-side tool decisions."
  tagline="Compare up to four tools across license, privacy, API, setup, and hardware attributes."
  eyebrow="Compare"
  pageTitle="Compare private AI tools"
  pageDescription="Compare self-hosted AI tools by license, privacy, setup, API support, and hardware requirements."
  canonicalUrl="https://enclavetools.com/compare"
  showSearch={true}
  showHero={true}
>
  <CompareView client:visible tools={allTools} />
</Layout>
