---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard.vue";
import UseCases from "../components/UseCases.vue";
import NewsletterSection from "../components/NewsletterSection.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import toolsData from "../data/tools.json";
import categories from "../data/categories.json";
import siteContent from "../data/site-content.json";
import filterOptions from "../data/filter-options.json";

const c = siteContent as Record<string, string>;
const PERSONA = (filterOptions as Record<string, any>).persona.map(
    (p: any) => p.value,
);

const allTools = toolsData.tools.flatMap((cat: any) =>
    cat.content.map((tool: any) => ({
        ...tool,
        category: [cat.category],
    })),
);

const totalTools = allTools.length;
const latestVerified = allTools
    .map(
        (tool: any) =>
            tool.last_verified || tool.last_updated || tool["date-added"],
    )
    .filter(Boolean)
    .sort()
    .at(-1);

const categoryCounts = new Map(
    toolsData.tools.map((cat: any) => [cat.category, cat.content.length]),
);

const featuredFor = (persona: string) =>
    allTools
        .filter((tool: any) => tool.personas?.includes(persona))
        .sort(
            (a: any, b: any) =>
                (b.popularity_score || 0) - (a.popularity_score || 0),
        )
        .slice(0, 8);

const categoryTiles = categories.slice(0, 8).map((cat: any) => ({
    ...cat,
    count:
        cat.category === "all"
            ? totalTools
            : categoryCounts.get(cat.category) || 0,
}));

const featuredTools = PERSONA.map((_, i) => featuredFor(PERSONA[i]));
const featuredCounts = PERSONA.map(
    (_, i) =>
        allTools.filter((tool: any) => tool.personas?.includes(PERSONA[i]))
            .length,
);

const hoverColors = [
    "hover:bg-accent-hue-1 hover:text-gray-900",
    "hover:bg-accent-hue-2 hover:text-gray-900",
    "hover:bg-accent-hue-3 hover:text-gray-900",
    "hover:bg-accent-hue-4 hover:text-gray-900",
    "hover:bg-accent-hue-5 hover:text-gray-900",
    "hover:bg-accent-hue-6 hover:text-gray-900",
    "hover:bg-accent-hue-7 hover:text-gray-900",
    "hover:bg-accent-hue-8 hover:text-gray-900",
];
---

<Layout
    site="Enclavetools"
    title={c.home_page_title ||
        "AI tools that keep your data inside your walls."}
    tagline={c.home_page_tagline ||
        "Find self-hosted, local, and offline AI software for teams that cannot afford leaks. Compare setup difficulty, license risk, hardware needs, telemetry, and API support before you open GitHub."}
    eyebrow={c.home_page_eyebrow || "Private AI tools directory"}
    showSearch={true}
    showHero={true}
>
    <OrganizationSchema />
    <ItemListSchema
        items={allTools}
        listName={c.home_schema_list_name || "AI Tools Directory - All Tools"}
    />
    <div class="px-4 md:px-8 pt-12 pb-16 border-b-2 border-gray-900">
        <section class="flex flex-col items-center max-w-[1400px] mx-auto">
            <div class="flex flex-wrap gap-3 justify-center">
                <a
                    href="/all"
                    class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-gray-900 text-white hover:bg-primary-500 hover:border-primary-500 rounded-none transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-card-hover no-underline"
                    >{c.cta_browse_all || "Browse all tools"}</a
                >
                <a
                    href="#use-cases"
                    class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-card-hover no-underline"
                    >{c.cta_use_cases || "Find tools for my use case"}</a
                >
                <a
                    href="/compare"
                    class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-card-hover no-underline"
                    >{c.cta_compare || "Compare tools"}</a
                >
                <a
                    href="/stack-builder"
                    class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-card-hover no-underline"
                    >{c.cta_build_stack || "Build a stack"}</a
                >
            </div>

            <dl
                class="w-full grid grid-cols-1 md:grid-cols-3 mt-12 border-y-2 border-gray-900"
                aria-label="Directory statistics"
            >
                <div
                    class="p-6 border-b-2 md:border-b-0 md:border-r-2 border-gray-900"
                >
                    <dt class="text-xl font-black">{totalTools}</dt><dd
                        class="text-xs font-black uppercase text-gray-500 tracking-wider"
                    >
                        {c.home_stat_tools_label || "tools listed"}
                    </dd>
                </div>
                <div
                    class="p-6 border-b-2 md:border-b-0 md:border-r-2 border-gray-900"
                >
                    <dt class="text-xl font-black">
                        {toolsData.tools.length}
                    </dt><dd
                        class="text-xs font-black uppercase text-gray-500 tracking-wider"
                    >
                        {c.home_stat_categories_label || "categories"}
                    </dd>
                </div>
                <div
                    class="p-6 border-b-2 md:border-b-0 md:border-r-0 border-gray-900"
                >
                    <dt class="text-xl font-black">
                        {
                            latestVerified
                                ? new Date(latestVerified).toLocaleDateString(
                                      "en-US",
                                      {
                                          month: "short",
                                          day: "numeric",
                                          year: "numeric",
                                      },
                                  )
                                : c.home_stat_build_data_fallback ||
                                  "Build data"
                        }
                    </dt><dd
                        class="text-xs font-black uppercase text-gray-500 tracking-wider"
                    >
                        {
                            c.home_stat_verification_label ||
                                "latest verification"
                        }
                    </dd>
                </div>
            </dl>
        </section>

        <section
            class="grid grid-cols-1 md:grid-cols-[minmax(280px,0.8fr)_1.2fr] gap-12 max-w-[1400px] mx-auto pt-12"
            aria-labelledby="category-heading"
        >
            <div class="flex flex-col py-auto items-start justify-center">
                <p
                    class="text-xs font-black uppercase tracking-widest text-gray-900"
                >
                    {c.home_category_eyebrow || "Start with the job"}
                </p>
                <h2
                    id="category-heading"
                    class="max-w-[620px] text-3xl md:text-4xl lg:text-5xl text-gray-900 leading-[0.98] font-black tracking-tight mt-4"
                >
                    {c.home_category_heading || "Choose a category."}
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {
                    categoryTiles.map((cat: any, index: number) => {
                        const hoverColorClass =
                            hoverColors[index % hoverColors.length];
                        return (
                            <a
                                href={`/${cat.category}`}
                                class={`group flex flex-col justify-between min-h-0 p-6 bg-white border-2 border-gray-900 text-gray-900 transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-card-hover shadow-[0_0_0_0_rgba(0,0,0,0)] no-underline ${hoverColorClass}`}
                            >
                                <div class="flex justify-between items-start w-full">
                                    <span class="text-lg font-black leading-tight max-w-[85%]">
                                        {cat.title}
                                    </span>
                                    <span
                                        class="text-lg font-black transform transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                        aria-hidden="true"
                                    >
                                        ↗
                                    </span>
                                </div>
                                <div class="flex justify-between items-end mt-4">
                                    <span class="inline-flex items-center px-2 py-1 text-xs font-black uppercase border-2 border-gray-900 bg-gray-900 text-white group-hover:bg-white group-hover:text-gray-900 transition-colors duration-150">
                                        {cat.count}{" "}
                                        {cat.count === 1 ? "tool" : "tools"}
                                    </span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </section>
    </div>
    <div id="browse"></div>
    <Dashboard
        client:visible
        category="all"
        isHomepage={true}
        transition:persist
        ssr-tools={allTools}
        ssr-total={allTools.length}
    />

    <UseCases
        client:visible
        featured-tools={featuredTools}
        featured-counts={featuredCounts}
        persona={PERSONA}
        eyebrow={c.home_usecase_eyebrow || "Use cases"}
        heading={c.home_usecase_heading ||
            "Start from the risk you need to control."}
    />

    <NewsletterSection siteContent={c} />
</Layout>
