---
import Layout from "../layouts/Layout.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import HeroSection from "../components/home/HeroSection.astro";
import StatsBar from "../components/home/StatsBar.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import CuratedRegistry from "../components/home/CuratedRegistry.astro";
import UseCasesTabs from "../components/home/UseCasesTabs.astro";
import StayAheadSection from "../components/home/StayAheadSection.astro";
import LaunchStacksSection from "../components/home/LaunchStacksSection.astro";
import SurveySection from "../components/home/SurveySection.astro";
// import ExpertCuratorsSection from "../components/home/ExpertCuratorsSection.astro";
import SubmitCTASection from "../components/home/SubmitCTASection.astro";
import FindPathSection from "../components/home/FindPathSection.astro";
import CompareTray from "../components/CompareTray.vue";

import toolsData from "../data/tools.json";
import categories from "../data/categories.json";
import siteContent from "../data/site-content.json";
import filterOptions from "../data/filter-options.json";

const c = siteContent as Record<string, string>;
const allTools = toolsData.tools.flatMap((cat: any) =>
    cat.content.map((tool: any) => ({
        ...tool,
        category: [cat.category],
    })),
);

const totalTools = allTools.length;
const latestVerified = allTools
    .map(
        (tool: any) =>
            tool.last_verified || tool.last_updated || tool["date-added"],
    )
    .filter(Boolean)
    .sort()
    .at(-1);

const categoryCounts = new Map(
    toolsData.tools.map((cat: any) => [cat.category, cat.content.length]),
);

const formatScore = (score: number) => {
    if (!score) return "N/A";
    if (score >= 1000) return Math.round(score / 1000) + "k";
    return String(score);
};

const totalCategories = categories.filter(
    (cat: any) => cat.category !== "all",
).length;

const categoryTitleMap = new Map(
    categories.map((cat: any) => [cat.category, cat.title]),
);

const topTools = [...allTools]
    .sort(
        (a: any, b: any) =>
            (b.popularity_score || 0) - (a.popularity_score || 0),
    )
    .slice(0, 6);

const hoverColors = [
    "hover:bg-accent-hue-1 hover:text-gray-900",
    "hover:bg-accent-hue-2 hover:text-gray-900",
    "hover:bg-accent-hue-3 hover:text-gray-900",
    "hover:bg-accent-hue-4 hover:text-gray-900",
    "hover:bg-accent-hue-5 hover:text-gray-900",
    "hover:bg-accent-hue-6 hover:text-gray-900",
    "hover:bg-accent-hue-7 hover:text-gray-900",
    "hover:bg-accent-hue-8 hover:text-gray-900",
];

const tileDescriptions = [
    "Run local LLMs on GPUs/CPUs",
    "Open-weight foundational models",
    "High-performance private stores",
    "Build autonomous local flows",
    "Self-hosted UIs for teams",
    "Local document ingestion & search",
    "Local transcription on device",
    "Local diffusion models",
];

const PERSONA = (filterOptions as Record<string, any>).persona.map(
    (p: any) => p.value,
);

const featuredFor = (persona: string) =>
    allTools
        .filter((tool: any) => tool.personas?.includes(persona))
        .sort(
            (a: any, b: any) =>
                (b.popularity_score || 0) - (a.popularity_score || 0),
        )
        .slice(0, 8);

const featuredTools = PERSONA.map((_, i: number) => featuredFor(PERSONA[i]));
const filteredCounts = PERSONA.map(
    (_, i: number) =>
        allTools.filter((tool: any) => tool.personas?.includes(PERSONA[i]))
            .length,
);

// const featuredCounts = PERSONA.map(
//     (_, i) =>
//         allTools.filter((tool: any) => tool.personas?.includes(PERSONA[i]))
//             .length,
// );

const categoryTiles = categories
    .filter((cat: any) => cat.category !== "all")
    .map((cat: any) => ({
        ...cat,
        count: categoryCounts.get(cat.category) || 0,
    }));

const useCaseContent: Record<
    string,
    { badge: string; heading: string; description: string; auditFocus: string }
> = {
    Developer: {
        badge: "Infrastructure Curated View",
        heading: "Shortlist local stack pieces on metadata",
        description:
            c.usecase_developer_copy ||
            "Shortlist self-hosted infrastructure by API support, licensing commercial safety, hardware targets, and container deployment options. Save hours of scraping GitHub READMEs.",
        auditFocus: "Outbound Telemetry & License safety",
    },
    "Business Owner": {
        badge: "Corporate Governance View",
        heading: "Protect enterprise client data from leakages",
        description:
            c.usecase_business_copy ||
            "Find tools that can be run internally or by an IT contractor without sending client records, contracts, or operations data to third-party model providers. Keep data strictly on prem.",
        auditFocus: "Ease of deployment & GUI Availability",
    },
    Healthcare: {
        badge: "Clinical & HIPAA-safe View",
        heading: "Transcribe and summarise clinical notes offline",
        description:
            c.usecase_healthcare_copy ||
            "Evaluate offline models that allow healthcare professionals to structure clinical diaries, dictate consultations, and extract patient diagnostic context safely within clinic walls.",
        auditFocus: "100% Offline Capability after setup",
    },
    Legal: {
        badge: "Confidential Discovery View",
        heading: "Audit contracts and NDA cases locally",
        description:
            c.usecase_legal_copy ||
            "Run text analysis, semantic document reviews, and litigation discovery setups on your local machine. Ensure NDA-bound materials remain completely private.",
        auditFocus: "Document Ingestion & PDF processing",
    },
    "Indie Hacker": {
        badge: "Solopreneur & Hobbyist View",
        heading: "Build lightweight AI widgets without API costs",
        description:
            c.usecase_indie_copy ||
            "Leverage open models running on your local Apple Silicon Mac, laptop, or home lab server to integrate AI summaries and speech models without any monthly bills.",
        auditFocus: "Low RAM Usage & Swift/JS languages",
    },
};
---

<Layout
    site="Enclavetools"
    title={c.home_page_title ||
        "AI tools that keep your data inside your walls."}
    tagline={c.home_page_tagline ||
        "Find self-hosted, local, and offline AI software for teams that cannot afford leaks. Compare setup difficulty, license risk, hardware needs, telemetry, and API support before you open GitHub."}
    pageTitle={c.home_page_title}
    pageDescription={c.home_page_tagline}
    showSearch={true}
>
    <OrganizationSchema />
    <ItemListSchema
        items={allTools}
        listName={c.home_schema_list_name || "AI Tools Directory - All Tools"}
    />

    <HeroSection siteContent={c} {totalTools} />
    <StatsBar
        siteContent={c}
        {totalTools}
        {totalCategories}
        {latestVerified}
    />
    <CategoryGrid
        {categoryTiles}
        {hoverColors}
        {tileDescriptions}
        siteContent={c}
    />
    <CuratedRegistry {topTools} {categoryTitleMap} {formatScore} {totalTools} />
    <UseCasesTabs
        {PERSONA}
        {featuredTools}
        {filteredCounts}
        {filterOptions}
        {useCaseContent}
        siteContent={c}
    />
    <StayAheadSection categoryCounts={Object.fromEntries(categoryCounts)} />
    <LaunchStacksSection />
    <SurveySection siteContent={c} />
    <!-- <ExpertCuratorsSection /> -->
    <SubmitCTASection siteContent={c} />
    <FindPathSection siteContent={c} />

    <NewsletterSection siteContent={c} />
    <CompareTray client:visible transition:persist tools={allTools as any} />
</Layout>
