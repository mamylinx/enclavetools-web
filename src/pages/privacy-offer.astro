---
import Layout from "../layouts/Layout.astro";
---

<Layout
  site="Enclavetools"
  title="See What Your Software Actually Sends | rpaudit Early Access"
  tagline="rpaudit shows every outbound connection on your machine or server — join the early-access list."
  pageTitle="See What Your Software Actually Sends | rpaudit Early Access"
  pageDescription="rpaudit shows every outbound connection on your machine or server, which program made it, and where it went. No packet-capture skills needed. Join the early-access list."
  canonicalUrl="https://enclavetools.com/privacy-offer"
  showSearch={false}
  showNav={false}
  showFooter={false}
  ogTitle="See What Your Software Actually Sends | rpaudit Early Access"
  ogDescription="rpaudit shows every outbound connection on your machine or server, which program made it, and where it went. Join the early-access list."
  ogImage="https://enclavetools.com/og-rpaudit-early-access.png"
  ogUrl="https://enclavetools.com/privacy-offer"
  ogType="website"
  ogSiteName="Enclavetools"
  twitterCard="summary_large_image"
  twitterTitle="See What Your Software Actually Sends | rpaudit Early Access"
  twitterDescription="rpaudit shows every outbound connection on your machine or server, which program made it, and where it went. Join the early-access list."
  twitterImage="https://enclavetools.com/og-rpaudit-early-access.png"
  keywords={[
    "rpaudit",
    "outbound connection audit",
    "AI telemetry",
    "vendor risk",
    "software phone home",
    "network traffic evidence",
    "privacy audit tool",
    "early access",
  ]}
  robots="index, follow"
>
  <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16">
    <div id="app">
      <!-- BRAND -->
      <p
        class="flex items-center gap-2 font-bold text-brand-forest text-lg mb-8"
      >
        <span aria-hidden="true">🛡️</span> rpaudit
      </p>

      <!-- HERO -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-brand-forest tracking-tight mb-6 leading-tight text-center md:text-left"
      >
        Software Says It's Private. <span class="text-brand-teal"
          >See What It Actually Sends.</span
        >
      </h1>

      <p class="text-lg md:text-xl text-brand-muted mb-8 max-w-2xl">
        rpaudit shows every outbound connection on your machine or server, which
        program made it, and where it went. No packet-capture skills needed.
        Join the early-access list.
      </p>

      <!-- HERO FORM -->
      <form
        id="earlyAccessHeroForm"
        data-early-access-form="hero"
        action="/api/contact"
        method="POST"
        class="bg-white border-2 border-brand-teal/30 p-6 md:p-8 rounded-3xl mb-6 shadow-md"
        novalidate
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div>
            <label
              for="heroEmail"
              class="block text-xs font-bold uppercase tracking-wider text-brand-forest/70 mb-2"
              >Work email</label
            >
            <input
              type="email"
              id="heroEmail"
              name="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
              class="w-full bg-brand-forest/5 border border-brand-forest/15 rounded-xl px-4 h-[52px] text-brand-forest font-semibold focus:outline-none focus:border-brand-teal transition-colors"
            />
          </div>
          <div>
            <label
              for="heroStack"
              class="block text-xs font-bold uppercase tracking-wider text-brand-forest/70 mb-2"
              >What do you want to check?</label
            >
            <select
              id="heroStack"
              name="stack"
              class="w-full bg-brand-forest/5 border border-brand-forest/15 rounded-xl px-4 h-[52px] text-brand-forest font-semibold focus:outline-none focus:border-brand-teal transition-colors"
            >
              <option value="">What do you want to check?</option>
              <option>Vendor / third-party software</option>
              <option>AI tools and agents</option>
              <option>Servers and containers</option>
              <option>Desktop apps</option>
              <option>Dev tools and dependencies</option>
              <option>Something else</option>
            </select>
          </div>
        </div>
        <button
          type="submit"
          data-submit-btn
          class="btn-primary block w-full text-base px-8 py-3"
        >
          Get early access
        </button>
        <p class="text-brand-muted text-sm mt-3">
          Free to join. Early members get first access and a say in what we
          build.
        </p>
      </form>
      <div
        data-success="hero"
        class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 px-6 py-4 rounded-2xl mb-6 max-w-2xl font-medium"
      >
        ✅ <strong>You're on the list.</strong> Check your inbox for the Software
        Phone-Home Checklist.
      </div>

      <!-- SPEC BADGE GRID -->
      <div
        class="flex flex-wrap gap-3 bg-brand-forest/5 p-5 md:p-6 rounded-2xl mb-10 border border-brand-forest/10"
      >
        <div
          class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm"
        >
          🛠️ Runs on: <span class="text-brand-forest font-bold"
            >Baremetal, K8s, container, VM</span
          >
        </div>
        <div
          class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm"
        >
          🔒 Goal: <span class="text-brand-forest font-bold"
            >Know what leaves</span
          >
        </div>
        <div
          class="bg-white px-4 py-2 rounded-full text-sm font-medium text-brand-muted border border-brand-forest/10 shadow-sm"
        >
          📡 Scope: <span class="text-brand-forest font-bold"
            >Any program you point it at</span
          >
        </div>
        <div
          class="bg-brand-forest text-white px-4 py-2 rounded-full text-sm font-bold shadow-sm"
        >
          ⏱️ Setup: Minutes
        </div>
      </div>

      <!-- ONE QUESTION -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        It usually starts with <span class="text-amber-500">one question.</span>
      </h2>
      <p class="text-lg text-brand-muted mb-4">
        Procurement asks it before approving a vendor. A client asks it before
        signing. An auditor puts it in writing.
      </p>
      <blockquote
        class="text-xl md:text-2xl text-brand-forest font-medium my-6 border-l-4 border-amber-500 pl-5"
      >
        "Does this software send our data anywhere?"
      </blockquote>
      <p class="text-lg text-brand-muted mb-4">
        The vendor says no. The privacy policy says no. But policies describe
        intentions. Network traffic shows behavior — and only one of those
        survives an audit.
      </p>

      <!-- TRAFFIC IS EVIDENCE -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        A promise isn't proof. <span class="text-amber-500"
          >Traffic is evidence.</span
        >
      </h2>
      <p class="text-lg text-brand-muted mb-6">
        Even well-run projects can ship with outbound reporting on. vLLM's docs
        say it collects usage data by default, and you opt out with an
        environment variable. That's disclosed, but only useful if someone read
        it
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">📦</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Bundled libraries and SDKs
          </h3>
          <p class="text-brand-muted mb-0">
            Code your vendor didn't write, reporting to servers you never heard
            of.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">📊</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Analytics and crash reports
          </h3>
          <p class="text-brand-muted mb-0">
            Small, frequent, and easy to miss in a code review.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🏠</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Vendors phoning home
          </h3>
          <p class="text-brand-muted mb-0">
            Products inside your own network that send usage data back to their
            maker.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🤖</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            AI tools and agents
          </h3>
          <p class="text-brand-muted mb-0">
            Assistants and plugins that send prompts, files or context to cloud
            models.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm sm:col-span-2"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🧟</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Software you forgot about
          </h3>
          <p class="text-brand-muted mb-0">
            Trials and retired tools that still talk after the evaluation ends.
          </p>
        </div>
      </div>

      <!-- THREE STEPS -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        Three steps. <span class="text-amber-500">Minutes, not weeks.</span>
      </h2>
      <div class="grid grid-cols-1 gap-4">
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm flex gap-4 items-start"
        >
          <span
            class="shrink-0 w-9 h-9 rounded-full bg-brand-teal text-white grid place-items-center font-bold"
            >1</span
          >
          <div>
            <h3 class="font-bold text-brand-forest text-lg mb-1">Install</h3>
            <p class="text-brand-muted mb-0">
              Add rpaudit to the machine, server, VM, container, or K8s cluster
              you want to check.
            </p>
          </div>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm flex gap-4 items-start"
        >
          <span
            class="shrink-0 w-9 h-9 rounded-full bg-brand-teal text-white grid place-items-center font-bold"
            >2</span
          >
          <div>
            <h3 class="font-bold text-brand-forest text-lg mb-1">
              Use the software normally
            </h3>
            <p class="text-brand-muted mb-0">
              Open the app, run the workflow, process the files. rpaudit watches
              in the background.
            </p>
          </div>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm flex gap-4 items-start"
        >
          <span
            class="shrink-0 w-9 h-9 rounded-full bg-brand-teal text-white grid place-items-center font-bold"
            >3</span
          >
          <div>
            <h3 class="font-bold text-brand-forest text-lg mb-1">
              See what leaves
            </h3>
            <p class="text-brand-muted mb-0">
              Every connection appears by program, destination and time, with
              known analytics, update, crash and cloud-AI endpoints labeled in
              plain English.
            </p>
          </div>
        </div>
      </div>

      <!-- ANSWERS NOT LOGS -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        You walk away with <span class="text-amber-500">answers, not logs.</span
        >
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🗺️</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            A map of who talks to whom
          </h3>
          <p class="text-brand-muted mb-0">
            Names and reasons instead of raw packets.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">📄</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            An evidence report
          </h3>
          <p class="text-brand-muted mb-0">
            Dated and version-specific, for an auditor, client or vendor review.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🧱</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Block rules you can copy
          </h3>
          <p class="text-brand-muted mb-0">
            For connections you decide shouldn't exist.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🔔</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Alerts on new destinations
          </h3>
          <p class="text-brand-muted mb-0">
            Know when an update starts sending somewhere new.
          </p>
        </div>
      </div>

      <!-- ACCOUNTABLE -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        Made for people <span class="text-amber-500"
          >accountable for the answer.</span
        >
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🏛️</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Security, IT and compliance leads
          </h3>
          <p class="text-brand-muted mb-0">
            You need evidence for regulators and auditors, not assurances.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🧾</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Procurement and vendor risk
          </h3>
          <p class="text-brand-muted mb-0">
            You approve software and need to see what it does before you sign.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">🤝</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Agencies, MSPs and consultants
          </h3>
          <p class="text-brand-muted mb-0">
            You install tools for clients and answer for what they send.
          </p>
        </div>
        <div
          class="bg-white border border-brand-forest/10 p-6 rounded-2xl shadow-sm"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">💻</span>
          <h3 class="font-bold text-brand-forest text-lg mb-1">
            Developers and privacy-minded teams
          </h3>
          <p class="text-brand-muted mb-0">
            You want to check tools, dependencies and AI assistants before
            trusting them.
          </p>
        </div>
      </div>

      <!-- BLIND TRUST -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        A privacy tool that <span class="text-amber-500"
          >doesn't ask for blind trust.</span
        >
      </h2>
      <div
        class="bg-brand-forest/5 border border-brand-forest/10 rounded-2xl p-6 md:p-8 flex gap-5 items-start"
      >
        <span class="text-4xl shrink-0" aria-hidden="true">🔐</span>
        <div>
          <p class="text-brand-forest font-bold text-lg mb-2">
            It runs on your machine and works offline. It sends nothing out, and
            you can verify that with the tool itself.
          </p>
          <p class="text-brand-muted mb-0">
            No account needed to run it. Built by the Enclavetools founder.
          </p>
        </div>
      </div>

      <!-- MAGNET / CHECKLIST -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        Not ready yet? <span class="text-amber-500"
          >Start with the checklist.</span
        >
      </h2>
      <div
        class="bg-white border-2 border-dashed border-brand-teal/50 p-6 md:p-8 rounded-3xl grid grid-cols-1 md:grid-cols-2 gap-6 items-center shadow-sm"
      >
        <div>
          <h3 class="font-bold text-brand-forest text-xl mb-2">
            The Software Phone-Home Checklist
          </h3>
          <p class="text-brand-muted mb-0">
            The Software Phone-Home Checklist: what to look for in any app's
            outbound traffic, which endpoint types signal analytics, updates and
            crash reporting, and how to move from a one-time check to continuous
            monitoring.
          </p>
        </div>
        <div>
          <form
            id="earlyAccessMagnetForm"
            data-early-access-form="magnet"
            action="/api/contact"
            method="POST"
            novalidate
          >
            <label
              for="magnetEmail"
              class="block text-xs font-bold uppercase tracking-wider text-brand-forest/70 mb-2"
              >Email</label
            >
            <input
              type="email"
              id="magnetEmail"
              name="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
              class="w-full bg-brand-forest/5 border border-brand-forest/15 rounded-xl px-4 h-[52px] text-brand-forest font-semibold focus:outline-none focus:border-brand-teal transition-colors mb-3"
            />
            <button
              type="submit"
              data-submit-btn
              class="btn-primary block w-full text-base px-8 py-3"
            >
              Send me the checklist
            </button>
          </form>
          <div
            data-success="magnet"
            class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 px-6 py-4 rounded-2xl font-medium"
          >
            ✅ Sent. Check your inbox.
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mt-12 mb-4">
        Questions
      </h2>
      <div
        class="bg-white border border-brand-forest/10 rounded-2xl px-6 shadow-sm divide-y divide-brand-forest/10"
      >
        <details class="py-4">
          <summary
            class="cursor-pointer font-semibold text-brand-forest text-lg"
            >Is this a firewall?</summary
          >
          <p class="text-brand-muted mt-2 mb-0">
            No. It shows you what's happening first. When you decide to block
            something, you get rules to do it.
          </p>
        </details>
        <details class="py-4">
          <summary
            class="cursor-pointer font-semibold text-brand-forest text-lg"
            >How is it different from Wireshark or an application firewall?</summary
          >
          <p class="text-brand-muted mt-2 mb-0">
            Packet tools show raw traffic you have to decode, and firewalls
            interrupt you with prompts. rpaudit explains each connection in
            plain language and turns the findings into a report you can hand to
            someone else.
          </p>
        </details>
        <details class="py-4">
          <summary
            class="cursor-pointer font-semibold text-brand-forest text-lg"
            >Does it only work for AI tools?</summary
          >
          <p class="text-brand-muted mt-2 mb-0">
            No. AI tools are one use case. It checks any software on the machine
            or server you point it at.
          </p>
        </details>
        <details class="py-4">
          <summary
            class="cursor-pointer font-semibold text-brand-forest text-lg"
            >What will early access cost?</summary
          >
          <p class="text-brand-muted mt-2 mb-0">
            Joining the list is free. Early members get first access and a say
            in what we build.
          </p>
        </details>
        <details class="py-4">
          <summary
            class="cursor-pointer font-semibold text-brand-forest text-lg"
            >When is launch, and on which platforms?</summary
          >
          <p class="text-brand-muted mt-2 mb-0">
            Early access opens to the list first — starting with Baremetal and
            container/VM installs, with K8s support following. List members hear
            first.
          </p>
        </details>
      </div>

      <!-- FINAL CTA -->
      <div class="text-center mt-12">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-forest mb-4">
          Next time someone asks, <span class="text-amber-500"
            >you'll know.</span
          >
        </h2>
        <p class="text-lg text-brand-muted mb-6 max-w-2xl mx-auto">
          Early access opens to the list first. Join now rather than waiting for
          the question to come from someone else.
        </p>
        <form
          id="earlyAccessFinalForm"
          data-early-access-form="final"
          action="/api/contact"
          method="POST"
          class="bg-white border-2 border-brand-teal/30 p-6 md:p-8 rounded-3xl shadow-md max-w-2xl mx-auto text-left"
          novalidate
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
              <label
                for="finalEmail"
                class="block text-xs font-bold uppercase tracking-wider text-brand-forest/70 mb-2"
                >Work email</label
              >
              <input
                type="email"
                id="finalEmail"
                name="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="w-full bg-brand-forest/5 border border-brand-forest/15 rounded-xl px-4 h-[52px] text-brand-forest font-semibold focus:outline-none focus:border-brand-teal transition-colors"
              />
            </div>
            <div>
              <label
                for="finalStack"
                class="block text-xs font-bold uppercase tracking-wider text-brand-forest/70 mb-2"
                >What do you want to check?</label
              >
              <select
                id="finalStack"
                name="stack"
                class="w-full bg-brand-forest/5 border border-brand-forest/15 rounded-xl px-4 h-[52px] text-brand-forest font-semibold focus:outline-none focus:border-brand-teal transition-colors"
              >
                <option value="">What do you want to check?</option>
                <option>Vendor / third-party software</option>
                <option>AI tools and agents</option>
                <option>Servers and containers</option>
                <option>Desktop apps</option>
                <option>Dev tools and dependencies</option>
                <option>Something else</option>
              </select>
            </div>
          </div>
          <button
            type="submit"
            data-submit-btn
            class="btn-primary block w-full text-base px-8 py-3"
          >
            Get early access
          </button>
        </form>
        <div
          data-success="final"
          class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 px-6 py-4 rounded-2xl mt-4 max-w-2xl mx-auto font-medium text-left"
        >
          ✅ <strong>You're on the list.</strong> Check your inbox for the checklist.
        </div>
      </div>

      <!-- PS -->
      <div class="border-t border-brand-forest/10 pt-8 mt-10 text-brand-muted">
        <strong class="text-amber-600">P.S.</strong> Every program on your network
        was written by someone else and updated by someone else. Ten minutes to see
        what it sends is a small price for certainty.
      </div>

      <!-- FOOTER -->
      <footer
        class="border-t border-brand-forest/10 mt-8 pt-6 text-brand-muted text-sm flex flex-wrap gap-x-2 gap-y-1"
      >
        <span>© rpaudit.</span>
        <a href="/privacy" class="text-brand-teal font-semibold hover:underline"
          >Privacy policy</a
        >
        <span aria-hidden="true">·</span>
