---
import Layout from "../layouts/Layout.astro";
import StackBuilder from "../components/StackBuilder.vue";
import toolsData from "../data/generated/tools.json";

const allTools = toolsData.tools.flatMap((cat: any) =>
  cat.content.map((tool: any) => ({
    ...tool,
    category: cat.category,
  })),
);
---

<Layout
  site="Enclavetools - Stack Builder"
  title="Stack Builder"
  tagline="Build a private AI stack from compatible tools"
  pageTitle="Private AI stack builder"
  pageDescription="Build a local, self-hosted AI stack from compatible inference, chat, RAG, vector, deployment, and monitoring tools."
  canonicalUrl="https://enclavetools.com/stack-builder"
  showSearch={true}
>
  <h1 class="sr-only">Stack Builder</h1>
  <StackBuilder client:visible tools={allTools} />
</Layout>
