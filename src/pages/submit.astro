---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SubmitForm from '../components/SubmitForm.vue';
---

<Layout title="Submit a Tool | Enclavetools" pageTitle="Submit a Tool">
  <main class="block max-w-[600px] mx-auto pt-10 px-4 md:px-0">
    <div class="text-left mb-6">
      <h1 class="text-4xl font-black text-gray-900 mb-2 uppercase tracking-tight">
        Submit a Tool
      </h1>
      <p class="text-gray-600 text-sm font-bold">
        Help grow the directory by submitting open-source, locally runnable AI tools.
      </p>
    </div>

    <div class="bg-white border-2 border-gray-900 rounded-none p-8 shadow-[4px_4px_0_0_rgba(17,24,39,1)]">
      <SubmitForm client:load />
    </div>
  </main>
</Layout>
