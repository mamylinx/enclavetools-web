---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import SubmitForm from "../components/SubmitForm.vue";
---

<Layout
  site="Enclavetools"
  title=" Submit a Tool"
  tagline="Help grow the directory by submitting open-source, locally runnable AI
  tools."
  showSearch={true}
  showHero={true}
>
  <div class="block max-w-[1400px] mx-auto pt-10 px-4 md:px-0">
    <div class="bg-white border-2 border-gray-900 p-8">
      <SubmitForm client:load />
    </div>
  </div>
</Layout>
