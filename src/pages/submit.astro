---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import SubmitForm from "../components/SubmitForm.vue";
---

<Layout
  site="Enclavetools"
  title="Submit a Tool"
  tagline="Paste a repo URL and we'll do the rest."
  pageTitle="Submit Your Tool"
  pageDescription="Submit an open-source, self-hosted AI tool to the Enclavetools directory. Just paste your repository URL and we'll fetch everything automatically."
  showSearch={false}
  showHero={true}
>
  <div class="max-w-[640px] mx-auto pt-12 pb-24 px-4 md:px-8">
    <div class="bg-white border-2 border-gray-900 shadow-brutal p-8">
      <SubmitForm client:load />
    </div>
  </div>
</Layout>
