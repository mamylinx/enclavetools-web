---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SubmitForm from '../components/SubmitForm.vue';
---

<Layout title="Submit a Tool | Enclavetools" pageTitle="Submit a Tool">
  <main class="page-layout" style="display: block; max-width: 600px; margin: 0 auto; padding-top: 40px;">
    <div class="empty-state" style="padding: 0; text-align: left; margin-bottom: 24px;">
      <h1 style="font-size: var(--desktop-heading-02); font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
        Submit a Tool
      </h1>
      <p style="color: var(--text-secondary); font-size: 15px;">
        Help grow the directory by submitting open-source, locally runnable AI tools.
      </p>
    </div>

    <div style="background: var(--white); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 32px; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
      <SubmitForm client:load />
    </div>
  </main>
</Layout>
