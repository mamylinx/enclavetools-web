---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import SubmitForm from "../components/SubmitForm.vue";
import { env } from "cloudflare:workers";

const sitekey = env.TURNSTILE_SITEKEY;
const workerUrl = env.TURNSTILE_WORKER_URL;
---

<Layout
  site="Enclavetools"
  eyebrow="Contribute to the Directory"
  title="Submit a Tool"
  tagline="Paste a repo URL and we'll do the rest."
  pageTitle="Submit Your Tool"
  pageDescription="Submit an open-source, self-hosted AI tool to the Enclavetools directory. Just paste your repository URL and we'll fetch everything automatically."
  showSearch={false}
  showHero={true}
>
  <div class="max-w-[640px] mx-auto pt-12 pb-24 px-4 md:px-8">
    <div class="bg-white/95 backdrop-blur-sm border border-brand-forest/5 rounded-3xl shadow-sm shadow-brand-forest/5 p-8 card-accent-border">
      <SubmitForm client:load sitekey={sitekey} workerUrl={workerUrl} />
    </div>
  </div>
</Layout>
