---
import Layout from "../../layouts/Layout.astro";
import SoftwareApplicationSchema from "../../components/schema/SoftwareApplicationSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import BookmarkButton from "../../components/BookmarkButton";
import toolsData from "../../data/tools.json";
import slugMap from "../../data/slug-map.json";
import { getWorksWith } from "../../utils/toolModel";

// Generate all tool slugs for static paths
export function getStaticPaths() {
  const allTools = toolsData.tools.flatMap((cat: any) =>
    cat.content.map((tool: any) => ({
      ...tool,
      category: cat.category,
    })),
  );
  return allTools.map((tool: any) => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;

// Flatten all tools with category info
const allTools = toolsData.tools.flatMap((cat: any) =>
  cat.content.map((tool: any) => ({
    ...tool,
    category: cat.category,
  })),
);

// Find the requested tool
const tool = allTools.find((t: any) => t.slug === slug);
if (!tool) {
  return Astro.redirect("/404");
}

// Get category (should exist since tool was found)
const category = tool.category;

const enrichTool = (item: any) => {
  const text = `${item.title} ${item.body} ${item.category}`.toLowerCase();
  const hardware = item.hardware || [];
  const deployment = item.deployment || [];
  const modelFormat = item.model_format || [];
  const lowResource = hardware.some((value: string) =>
    value.includes("Low-resource"),
  );
  const gpuOnly =
    hardware.length > 0 &&
    hardware.every(
      (value: string) =>
        value.includes("GPU") ||
        value.includes("CUDA") ||
        value.includes("ROCm"),
    );
  const docker = deployment.includes("Docker");
  const gui =
    item.category === "chat-interfaces" ||
    text.includes("gui") ||
    text.includes("visual") ||
    text.includes("no-code");
  return {
    ...item,
    plain_description: item.plain_description || item.body,
    technical_description: item.technical_description || item.body,
    commercial_use:
      item.commercial_use ??
      !/agpl|non-commercial|cc by-nc/i.test(item.license || ""),
    setup_difficulty:
      item.setup_difficulty ||
      (gui || lowResource
        ? "Low"
        : docker
          ? "Medium"
          : gpuOnly
            ? "High"
            : "Medium"),
    min_ram_gb: item.min_ram_gb || (lowResource ? 8 : gpuOnly ? 16 : 8),
    recommended_ram_gb: item.recommended_ram_gb || (gpuOnly ? 32 : 16),
    telemetry: item.telemetry || "None",
    offline_after_setup: item.offline_after_setup ?? true,
    paid_support:
      item.paid_support ??
      Boolean(item.url && !item.url.includes("github.com")),
    gui_available: item.gui_available ?? gui,
    docker_available: item.docker_available ?? docker,
    openai_api:
      item.openai_api ??
      (text.includes("openai") || text.includes("oai compatible")),
    rest_api:
      item.rest_api ?? (text.includes("api") || item.category === "deployment"),
    fine_tuning:
      item.fine_tuning ??
      (item.category === "fine-tuning-training" || text.includes("fine-tun")),
    quantization:
      item.quantization ??
      (modelFormat.some((value: string) =>
        ["GGUF", "GPTQ", "AWQ"].includes(value),
      ) ||
        text.includes("quant")),
    community_notes_count: item.community_notes_count || 0,
    community_guides_count: item.community_guides_count || 0,
    last_verified:
      item.last_verified || item.last_updated || item["date-added"],
  };
};

const enrichedTool = enrichTool(tool);
const worksWithTools = getWorksWith(enrichedTool, allTools, 4);

// Get related tools (same category, different slug, deterministic order)
const relatedTools = allTools
  .filter((t: any) => t.category === category && t.slug !== slug)
  .sort(
    (a: any, b: any) => (b.popularity_score || 0) - (a.popularity_score || 0),
  )
  .slice(0, 4);

// Format date helper
const formatDate = (dateStr: string) => {
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return dateStr;
  }
};

const formattedDate = formatDate(tool["date-added"]);
const canonicalUrl = `https://enclavetools.com/tools/${tool.slug}`;
const faviconUrl = `/favicons/${slug}.png`;

const seoTitle = tool.title;
const seoDescription = tool.body;

// Get category display name (capitalize first letter of each word)
const categoryTitle = category
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");

const breadcrumbs = [
  { name: "Home", url: "https://enclavetools.com" },
  { name: categoryTitle, url: `https://enclavetools.com/${category}` },
  { name: tool.title },
];

const encodedShareText = encodeURIComponent(
  `Check out ${enrichedTool.title} - ${enrichedTool.body}`,
);
const encodedCanonicalUrl = encodeURIComponent(canonicalUrl);
const xShareUrl = `https://x.com/intent/post?text=${encodedShareText}&url=${encodedCanonicalUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedCanonicalUrl}`;

const yesNo = (value: boolean) => (value ? "Yes" : "No");
const scorecard = [
  ["License", enrichedTool.license || "Not specified"],
  ["Commercial use", yesNo(enrichedTool.commercial_use)],
  ["OpenAI-compatible API", yesNo(enrichedTool.openai_api)],
  ["REST API", yesNo(enrichedTool.rest_api)],
  ["Fine-tuning support", yesNo(enrichedTool.fine_tuning)],
  [
    "Quantization support",
    enrichedTool.quantization
      ? enrichedTool.model_format?.join(", ") || "Yes"
      : "No",
  ],
  ["Docker available", yesNo(enrichedTool.docker_available)],
  ["GUI / no-code available", yesNo(enrichedTool.gui_available)],
  ["Telemetry", enrichedTool.telemetry],
  ["Offline after setup", yesNo(enrichedTool.offline_after_setup)],
];

const featureBadges = [
  categoryTitle,
  enrichedTool.license,
  enrichedTool.setup_difficulty
    ? `${enrichedTool.setup_difficulty} setup`
    : null,
  enrichedTool.popularity_score
    ? `${enrichedTool.popularity_score.toLocaleString("en-US")} stars`
    : null,
].filter(Boolean);
---

<Layout
  site={`Enclavetools - ${tool.title}`}
  title={tool.title}
  tagline={tool.body}
  pageTitle={seoTitle}
  pageDescription={seoDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={seoTitle}
  ogDescription={seoDescription}
  ogUrl={canonicalUrl}
  ogImage="/enclavetools.svg"
  ogType="website"
  ogSiteName="Enclavetools"
  twitterCard="summary"
  twitterTitle={seoTitle}
  twitterDescription={seoDescription}
  twitterImage={faviconUrl}
  pageFavicon={faviconUrl}
  showSearch={true}
  showHero={true}
>
  <SoftwareApplicationSchema
    name={tool.title}
    description={tool.body}
    url={tool.url}
    tag={tool.tag}
    dateAdded={tool["date-added"]}
    category={category}
  />
  <BreadcrumbSchema items={breadcrumbs} />

  <div class="px-4 md:px-8 pt-12 pb-8">
    <section
      class="grid grid-cols-1 gap-12 max-w-[1400px] mx-auto items-end"
    >
      <div class="flex flex-wrap gap-3 justify-center">
        {
          enrichedTool.github_url || enrichedTool.url ? (
            <a
              href={enrichedTool.github_url || enrichedTool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-gray-900 text-white hover:bg-primary-500 hover:border-primary-500 rounded-none transition-colors no-underline"
            >
              View on GitHub
            </a>
          ) : null
        }

        {
          enrichedTool.url ? (
            <a
              href={enrichedTool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-colors no-underline"
            >
              Official site
            </a>
          ) : null
        }
        <button
          class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-colors no-underline"
          data-tool-action="share"
        >
          Share
        </button>
        <button
          class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-colors no-underline"
          data-tool-action="compare"
          data-slug={slug}
        >
          Add to compare
        </button>
        <div class="relative" id="stack-picker-anchor">
          <button
            class="inline-flex items-center h-12 border-2 border-gray-900 px-4 font-black uppercase tracking-wider text-xs bg-white text-gray-900 hover:bg-primary-500 hover:text-white hover:border-primary-500 rounded-none transition-colors no-underline"
            data-tool-action="stack"
            data-slug={slug}
            id="add-to-stack-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="stack-picker-dropdown"
          >
            Add to stack
          </button>
          <div
            id="stack-picker-dropdown"
            role="dialog"
            aria-label="Choose a stack"
            aria-modal="true"
            class="hidden absolute left-0 top-full mt-1 z-50 min-w-[260px] border-2 border-gray-900 bg-white shadow-brutal"
          >
            <p class="px-4 pt-3 pb-2 text-xs font-black uppercase tracking-wider text-gray-500">Choose a stack</p>
            <div id="stack-picker-list" class="flex flex-col max-h-56 overflow-y-auto border-t-2 border-gray-900"></div>
            <div class="border-t-2 border-gray-900" id="stack-picker-footer">
              <!-- Default: show the create button -->
              <button
                id="stack-picker-new"
                class="w-full text-left px-4 py-3 text-xs font-black uppercase tracking-wider text-gray-900 hover:bg-primary-500 hover:text-white transition-colors"
              >
                + Create new stack
              </button>
              <!-- Inline create form (hidden by default) -->
              <div id="stack-picker-create-form" class="hidden px-3 py-3 flex flex-col gap-2">
                <input
                  id="stack-picker-name-input"
                  type="text"
                  maxlength="30"
                  placeholder="Stack name"
                  class="w-full border-2 border-gray-900 px-3 h-10 text-xs font-bold text-gray-900 focus:outline-none focus:border-primary-500 transition-colors"
                />
                <div class="flex gap-2">
                  <button
                    id="stack-picker-confirm"
                    type="button"
                    class="flex-1 h-10 bg-gray-900 text-white text-xs font-black uppercase tracking-wider hover:bg-primary-500 transition-colors border-none cursor-pointer"
                  >
                    Create
                  </button>
                  <button
                    id="stack-picker-cancel"
                    type="button"
                    class="flex-1 h-10 border-2 border-gray-900 text-gray-900 text-xs font-black uppercase tracking-wider hover:bg-gray-100 transition-colors cursor-pointer bg-white"
                  >
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <BookmarkButton
          client:load
          slug={slug}
          title={enrichedTool.title}
          body={enrichedTool.body}
          url={enrichedTool.url}
          category={category}
          variant="default"
        />
      </div>
    </section>
  </div>

  <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-12">
    <nav class="flex gap-2 text-xs font-black mb-6 text-gray-500">
      <a href="/" class="text-gray-900 hover:text-primary-500 transition-colors"
        >Home</a
      ><span>/</span><a
        href={`/${category}`}
        class="text-gray-900 hover:text-primary-500 transition-colors"
        >{categoryTitle}</a
      ><span>/</span><span>{enrichedTool.title}</span>
    </nav>

    <article class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside
        class="sticky top-24 flex flex-col gap-3 self-start hidden lg:flex"
        aria-label="Tool page sections"
      >
        <a
          href="#overview"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Overview</a
        >
        <a
          href="#technical"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Technical</a
        >
        <a
          href="#privacy"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Privacy &amp; Data</a
        >
        <a
          href="#setup"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Setup</a
        >
        <a
          href="#hardware"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Hardware</a
        >
        <a
          href="#works-with"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Works With</a
        >
        <!-- <a
          href="#community"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Community</a
        > -->
        <a
          href="#related"
          class="text-gray-900 font-black text-xs uppercase hover:text-primary-500 transition-colors"
          >Related</a
        >
      </aside>

      <div class="flex flex-col gap-8">
        <div class="flex flex-wrap gap-2 mt-8">
          {
            featureBadges.map((badge: string) => (
              <span class="border-2 border-gray-900 px-2 py-1 text-xs font-black uppercase tracking-wider">
                {badge}
              </span>
            ))
          }
        </div>

        <section id="overview" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Overview
          </p>
          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-900 border-2 border-gray-900"
          >
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">Plain English</h2>
              <p class="text-base leading-relaxed text-gray-700">
                {enrichedTool.plain_description}
              </p>
            </div>
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">Technical</h2>
              <p class="text-base leading-relaxed text-gray-700">
                {enrichedTool.technical_description}
              </p>
            </div>
          </div>
        </section>

        <section id="technical" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Technical scorecard
          </p>
          <div class="border-2 border-gray-900 border-b-0">
            {
              scorecard.map(([label, value]) => (
                <div class="grid grid-cols-[minmax(180px,0.8fr)_1.2fr] border-b-2 border-gray-900">
                  <>
                    <span class="p-6 text-sm text-gray-600 border-r-2 border-gray-900">
                      {label}
                    </span>
                    <strong class="p-6 text-sm font-black">{value}</strong>
                  </>
                </div>
              ))
            }
          </div>
        </section>

        <section id="privacy" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Data &amp; Privacy
          </p>
          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-900 border-2 border-gray-900"
          >
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">
                Does it send data online?
              </h2><p class="text-base leading-relaxed text-gray-700">
                {
                  enrichedTool.offline_after_setup
                    ? "After setup, this listing is marked as usable offline. Confirm network behavior against the upstream project before regulated deployment."
                    : "This listing is not marked offline after setup."
                }
              </p>
            </div>
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">Does it store history?</h2><p
                class="text-base leading-relaxed text-gray-700"
              >
                Not verified in this directory yet. Review the upstream docs for
                persistence, logs, and workspace storage.
              </p>
            </div>
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">License checks?</h2><p
                class="text-base leading-relaxed text-gray-700"
              >
                {
                  enrichedTool.commercial_use
                    ? "Commercial use is marked as allowed or likely allowed by the listed license."
                    : "The listed license needs review before commercial use."
                }
              </p>
            </div>
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">Telemetry?</h2><p
                class="text-base leading-relaxed text-gray-700"
              >
                {enrichedTool.telemetry}
              </p>
            </div>
          </div>
          <p class="mt-4 text-gray-500 text-sm">
            Last verified: {formatDate(enrichedTool.last_verified)}. Maintainer
            verification should be treated as directory guidance, not legal
            advice.
          </p>
        </section>

        <section id="setup" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Setup &amp; Installation
          </p>
          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-900 border-2 border-gray-900"
          >
            <div class="bg-white p-6">
              <span
                class={`inline-block w-3 h-3 rounded-full mr-2 ${String(enrichedTool.setup_difficulty).toLowerCase() === "low" ? "bg-green-600" : String(enrichedTool.setup_difficulty).toLowerCase() === "high" ? "bg-red-500" : "bg-yellow-400"}`}
              ></span><strong class="font-black text-lg"
                >{enrichedTool.setup_difficulty}</strong
              ><p class="text-base leading-relaxed text-gray-700 mt-2">
                {
                  enrichedTool.setup_difficulty === "Low"
                    ? "GUI, low-resource, or simple install path likely available."
                    : enrichedTool.setup_difficulty === "High"
                      ? "Expect GPU, framework, or production deployment work."
                      : "A developer can usually get this running with standard docs."
                }
              </p>
            </div>
            <div class="bg-white p-6">
              <h2 class="text-xl font-black mb-2">Prerequisites</h2><p
                class="text-base leading-relaxed text-gray-700"
              >
                {
                  [
                    ...(enrichedTool.language || []),
                    ...(enrichedTool.deployment || []),
                  ]
                    .slice(0, 5)
                    .join(", ") || "Check upstream documentation."
                }
              </p>
            </div>
          </div>
          <pre
            class="border-2 border-gray-900 p-6 overflow-x-auto mt-4 text-sm bg-gray-50"><code>{`# Start with the official project documentation\n# ${enrichedTool.github_url || enrichedTool.url || canonicalUrl}`}</code></pre>
        </section>

        <section id="hardware" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Hardware Requirements
          </p>
          <div class="border-2 border-gray-900 border-b-0">
            <div
              class="grid grid-cols-[minmax(180px,0.8fr)_1.2fr] border-b-2 border-gray-900"
            >
              <span
                class="p-6 text-sm text-gray-600 border-r-2 border-gray-900"
                >RAM</span
              ><strong class="p-6 text-sm font-black"
                >{enrichedTool.min_ram_gb} GB minimum / {
                  enrichedTool.recommended_ram_gb
                } GB recommended</strong
              >
            </div>
            <div
              class="grid grid-cols-[minmax(180px,0.8fr)_1.2fr] border-b-2 border-gray-900"
            >
              <span
                class="p-6 text-sm text-gray-600 border-r-2 border-gray-900"
                >Hardware tags</span
              ><strong class="p-6 text-sm font-black"
                >{enrichedTool.hardware?.join(", ") || "Not specified"}</strong
              >
            </div>
            <div
              class="grid grid-cols-[minmax(180px,0.8fr)_1.2fr] border-b-2 border-gray-900"
            >
              <span
                class="p-6 text-sm text-gray-600 border-r-2 border-gray-900"
                >Model formats</span
              ><strong class="p-6 text-sm font-black"
                >{
                  enrichedTool.model_format?.join(", ") || "Not specified"
                }</strong
              >
            </div>
            <div
              class="grid grid-cols-[minmax(180px,0.8fr)_1.2fr] border-b-2 border-gray-900"
            >
              <span
                class="p-6 text-sm text-gray-600 border-r-2 border-gray-900"
                >Primary language</span
              ><strong class="p-6 text-sm font-black"
                >{enrichedTool.language?.join(", ") || "Not specified"}</strong
              >
            </div>
          </div>
        </section>

        <section id="works-with" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Works Well With
          </p>
          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-900 border-2 border-gray-900"
          >
            {
              worksWithTools.map((t: any) => (
                <a
                  href={`/tools/${t.slug}`}
                  class="flex flex-col gap-2 bg-white p-6 no-underline hover:bg-yellow-400 transition-colors group"
                >
                  <strong class="text-xl font-black text-gray-900 group-hover:text-primary-500 transition-colors">
                    {t.title}
                  </strong>
                  <span class="text-gray-600 leading-snug text-sm">
                    {t.plain_description || t.body?.slice(0, 120)}
                  </span>
                </a>
              ))
            }
          </div>
          <div class="mt-4">
            <a
              href={`/stack-builder?stack=${[slug, ...worksWithTools.slice(0, 3).map((item: any) => item.slug)].join(",")}`}
              class="border-2 border-gray-900 bg-white text-gray-900 px-4 h-12 font-black cursor-pointer hover:bg-primary-500 hover:text-white transition-colors no-underline text-sm inline-flex items-center"
            >
              Open suggested stack
            </a>
          </div>
        </section>

        <!-- <section id="community" class="py-12 border-b-2 border-gray-900">
          <p
            class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider"
          >
            Community
          </p>
          <div class="grid grid-cols-2 border-2 border-gray-900 mb-4">
            <div class="p-6 border-r-2 border-gray-900 flex flex-col gap-2">
              <strong class="text-5xl font-black leading-none"
                >{enrichedTool.community_notes_count}</strong
              ><span class="text-sm font-bold text-gray-600"
                >structured notes</span
              >
            </div>
            <div class="p-6 flex flex-col gap-2">
              <strong class="text-5xl font-black leading-none"
                >{enrichedTool.community_guides_count}</strong
              ><span class="text-sm font-bold text-gray-600">guides</span>
            </div>
          </div>
          <form class="grid gap-3 border-2 border-gray-900 p-6">
            <h2 class="text-xl font-black">Suggest a correction</h2>
            <label
              class="grid gap-2 text-xs font-black uppercase tracking-wider"
              >Field<select
                class="w-full border-2 border-gray-900 px-4 h-12 font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500"
                ><option>License</option><option>Telemetry</option><option
                  >Hardware</option
                ><option>Setup difficulty</option></select
              ></label
            >
            <label
              class="grid gap-2 text-xs font-black uppercase tracking-wider"
              >Correction<textarea
                class="w-full border-2 border-gray-900 px-4 py-3 font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500"
                placeholder="What should this say?"></textarea></label
            >
            <label
              class="grid gap-2 text-xs font-black uppercase tracking-wider"
              >Source URL<input
                class="w-full border-2 border-gray-900 px-4 h-12 font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500"
                type="url"
                placeholder="https://..."
              /></label
            >
            <button
              class="justify-self-start bg-gray-900 text-white px-4 h-12 font-black hover:bg-primary-500 transition-colors cursor-pointer border-none inline-flex items-center"
              type="button">Submit for review</button
            >
          </form>
        </section> -->

        {
          relatedTools.length > 0 && (
            <section id="related" class="py-12 border-b-2 border-gray-900">
              <p class="text-xs font-black uppercase mb-4 text-gray-500 tracking-wider">
                You might also evaluate
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-900 border-2 border-gray-900">
                {relatedTools.map((t: any) => (
                  <a
                    href={`/tools/${t.slug}`}
                    class="flex flex-col gap-2 bg-white p-6 no-underline hover:bg-yellow-400 transition-colors group"
                  >
                    <strong class="text-xl font-black text-gray-900 group-hover:text-primary-500 transition-colors">
                      {t.title}
                    </strong>
                    <span class="text-gray-600 leading-snug text-sm">
                      {t.body?.slice(0, 96)}...
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <div class="flex gap-3 pt-8 font-black">
          <a
            href={xShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-gray-900 bg-white text-gray-900 px-4 h-12 font-black cursor-pointer hover:bg-primary-500 hover:text-white transition-colors no-underline text-sm inline-flex items-center"
            >Share on X</a
          >
          <a
            href={linkedinShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-gray-900 bg-white text-gray-900 px-4 h-12 font-black cursor-pointer hover:bg-primary-500 hover:text-white transition-colors no-underline text-sm inline-flex items-center"
            >Share on LinkedIn</a
          >
        </div>
      </div>
    </article>
  </div>

  <script type="module">
    const copyText = async (value) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(value);
          return;
        } catch {
          /* fall through */
        }
      }

      const textarea = document.createElement("textarea");
      textarea.value = value;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      textarea.style.top = "0";
      document.body.appendChild(textarea);
      textarea.select();
      const copied = document.execCommand("copy");
      document.body.removeChild(textarea);
      if (!copied) throw new Error("Copy command failed");
    };

    const setTemporaryText = (button, text, fallback) => {
      button.textContent = text;
      window.setTimeout(() => {
        button.textContent = fallback;
      }, 2200);
    };

    const addLocalSlug = (key, slug, max, append = true) => {
      let slugs = [];
      try {
        slugs = JSON.parse(localStorage.getItem(key) || "[]");
      } catch {}
      if (!slug) return slugs.slice(0, max);
      if (!slugs.includes(slug)) {
        slugs = append ? [...slugs, slug] : [slug, ...slugs];
      }
      slugs = slugs.slice(0, max);
      localStorage.setItem(key, JSON.stringify(slugs));
      return slugs;
    };

    const handleToolAction = async (event) => {
      const button = event.target.closest("[data-tool-action]");
      if (!button) return;

      const action = button.dataset.toolAction;
      const slug = button.dataset.slug;

      if (action === "share") {
        try {
          await copyText(window.location.href);
          setTemporaryText(button, "Copied", "Share");
        } catch {
          setTemporaryText(button, "Copy failed", "Share");
        }
      }

      if (action === "compare") {
        const slugs = addLocalSlug("enclavetools-compare", slug, 4);
        localStorage.setItem("enclavetools-compare", JSON.stringify(slugs));
        window.dispatchEvent(
          new CustomEvent("compare:changed", { detail: { slugs } }),
        );
        setTemporaryText(button, "Added", "Add to compare");
      }

      if (action === "stack") {
        openStackPicker(slug, button);
      }
    };

    /* ── Stack Picker ───────────────────────────────────────────── */
    const STORAGE_KEY = "enclavetools-stacks";
    const ACTIVE_KEY  = "enclavetools-active-stack";
    const LEGACY_KEY  = "enclavetools-stack";
    const MAX_TOOLS   = 8;

    const readStacks  = () => { try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : []; } catch { return []; } };
    const writeStacks = (s) => { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); window.dispatchEvent(new CustomEvent('stacks:changed', { detail: { stacks: s } })); };

    const migrateLegacy = () => {
      try {
        const legacy = localStorage.getItem(LEGACY_KEY);
        if (!legacy) return;
        const tools = JSON.parse(legacy);
        localStorage.removeItem(LEGACY_KEY);
        if (!Array.isArray(tools) || !tools.length) return;
        if (readStacks().length) return;
        const ts = new Date().toISOString();
        writeStacks([{ id: "default", name: "My Stack", tools: tools.slice(0, MAX_TOOLS), created: ts, updated: ts }]);
        localStorage.setItem(ACTIVE_KEY, "default");
      } catch { /* silent */ }
    };

    const genId = () => crypto.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

    const ensureStacks = () => {
      migrateLegacy();
      let stacks = readStacks();
      if (!stacks.length) {
        const ts = new Date().toISOString();
        const stack = { id: genId(), name: "My Stack", tools: [], created: ts, updated: ts };
        stacks = [stack];
        writeStacks(stacks);
        localStorage.setItem(ACTIVE_KEY, stack.id);
      }
      return stacks;
    };

    const addToolToStack = (stackId, toolSlug) => {
      const stacks = readStacks();
      const stack  = stacks.find((s) => s.id === stackId);
      if (!stack || stack.tools.includes(toolSlug) || stack.tools.length >= MAX_TOOLS) return false;
      stack.tools = [toolSlug, ...stack.tools].slice(0, MAX_TOOLS);
      stack.updated = new Date().toISOString();
      writeStacks(stacks);
      localStorage.setItem(ACTIVE_KEY, stackId);
      return true;
    };

    const createAndAddStack = (toolSlug) => {
      const stacks = readStacks();
      const ts = new Date().toISOString();
      const stack = { id: genId(), name: "My Stack", tools: [toolSlug], created: ts, updated: ts };
      stacks.push(stack);
      writeStacks(stacks);
      localStorage.setItem(ACTIVE_KEY, stack.id);
      return stack;
    };

    let _pickerSlug = null;

    const closeDropdown = () => {
      const dd  = document.getElementById("stack-picker-dropdown");
      const btn = document.getElementById("add-to-stack-btn");
      if (dd)  dd.classList.add("hidden");
      if (btn) btn.setAttribute("aria-expanded", "false");
      // Always reset the create form to its default state on close
      const newBtn = document.getElementById("stack-picker-new");
      const form   = document.getElementById("stack-picker-create-form");
      if (newBtn) newBtn.classList.remove("hidden");
      if (form)   form.classList.add("hidden");
    };

    const renderStackList = (toolSlug) => {
      const list = document.getElementById("stack-picker-list");
      if (!list) return;
      const stacks   = ensureStacks();
      const activeId = localStorage.getItem(ACTIVE_KEY);
      list.innerHTML = "";
      stacks.forEach((stack) => {
        const alreadyIn = stack.tools.includes(toolSlug);
        const full      = stack.tools.length >= MAX_TOOLS && !alreadyIn;
        const isActive  = stack.id === activeId;
        const item = document.createElement("button");
        item.type = "button";
        item.disabled = alreadyIn || full;
        item.className = [
          "w-full text-left px-4 py-3 flex items-center justify-between gap-3 text-xs font-black uppercase tracking-wider transition-colors border-none outline-none",
          alreadyIn || full
            ? "text-gray-400 cursor-not-allowed bg-gray-50"
            : "text-gray-900 hover:bg-primary-500 hover:text-white cursor-pointer bg-white",
        ].join(" ");
        const dot = isActive
          ? `<span class="inline-block w-2 h-2 rounded-full bg-primary-500 flex-shrink-0"></span>`
          : `<span class="inline-block w-2 h-2 rounded-full border-2 border-gray-300 flex-shrink-0"></span>`;
        const badge = alreadyIn ? "already added" : full ? "full" : `${stack.tools.length}/${MAX_TOOLS}`;
        item.innerHTML = `<span class="flex items-center gap-2 truncate">${dot}<span class="truncate">${stack.name}</span></span><span class="text-gray-400 font-normal normal-case flex-shrink-0">${badge}</span>`;
        if (!alreadyIn && !full) {
          item.addEventListener("click", (e) => {
            e.stopPropagation();
            addToolToStack(stack.id, toolSlug);
            closeDropdown();
            window.location.assign(`/stack-builder?stack=${stack.id}`);
          });
        }
        list.appendChild(item);
      });
    };

    const openStackPicker = (toolSlug, triggerBtn) => {
      _pickerSlug = toolSlug;
      const dd = document.getElementById("stack-picker-dropdown");
      if (!dd) return;
      const isOpen = !dd.classList.contains("hidden");
      if (isOpen) { closeDropdown(); return; }
      renderStackList(toolSlug);
      dd.classList.remove("hidden");
      triggerBtn.setAttribute("aria-expanded", "true");
    };

    const showCreateForm = (e) => {
      e && e.stopPropagation();
      const newBtn  = document.getElementById("stack-picker-new");
      const form    = document.getElementById("stack-picker-create-form");
      const input   = document.getElementById("stack-picker-name-input");
      if (!newBtn || !form) return;
      newBtn.classList.add("hidden");
      form.classList.remove("hidden");
      if (input) { input.value = ""; setTimeout(() => input.focus(), 0); }
    };

    const hideCreateForm = (e) => {
      e && e.stopPropagation();
      const newBtn = document.getElementById("stack-picker-new");
      const form   = document.getElementById("stack-picker-create-form");
      if (!newBtn || !form) return;
      form.classList.add("hidden");
      newBtn.classList.remove("hidden");
    };

    const commitCreateStack = (e) => {
      e && e.stopPropagation();
      const input = document.getElementById("stack-picker-name-input");
      const rawName = input ? input.value.trim() : "";
      const name = rawName.slice(0, 30) || "My Stack";
      const stack  = createAndAddStack(_pickerSlug);
      const stacks = readStacks();
      const s = stacks.find((x) => x.id === stack.id);
      if (s) { s.name = name; writeStacks(stacks); }
      hideCreateForm();
      closeDropdown();
      window.location.assign(`/stack-builder?stack=${stack.id}`);
    };

    const handleCreateFormKeyDown = (e) => {
      if (e.key === "Enter")  { e.preventDefault(); commitCreateStack(); }
      if (e.key === "Escape") { e.stopPropagation(); hideCreateForm(); }
    };

    const handleOutsideClick = (e) => {
      const anchor = document.getElementById("stack-picker-anchor");
      if (anchor && !anchor.contains(e.target)) closeDropdown();
    };

    const handleKeyDown = (e) => {
      if (e.key === "Escape") closeDropdown();
    };

    const bindToolActions = () => {
      document.removeEventListener("click", handleToolAction);
      document.addEventListener("click", handleToolAction);
      document.removeEventListener("click", handleOutsideClick);
      document.addEventListener("click", handleOutsideClick);
      document.removeEventListener("keydown", handleKeyDown);
      document.addEventListener("keydown", handleKeyDown);

      const newBtn  = document.getElementById("stack-picker-new");
      const confirm = document.getElementById("stack-picker-confirm");
      const cancel  = document.getElementById("stack-picker-cancel");
      const input   = document.getElementById("stack-picker-name-input");
      if (newBtn)  { newBtn.removeEventListener("click",    showCreateForm);         newBtn.addEventListener("click",    showCreateForm); }
      if (confirm) { confirm.removeEventListener("click",   commitCreateStack);      confirm.addEventListener("click",   commitCreateStack); }
      if (cancel)  { cancel.removeEventListener("click",    hideCreateForm);         cancel.addEventListener("click",    hideCreateForm); }
      if (input)   { input.removeEventListener("keydown",   handleCreateFormKeyDown); input.addEventListener("keydown",   handleCreateFormKeyDown); }
    };

    bindToolActions();
    document.addEventListener("astro:page-load", bindToolActions);
  </script>
</Layout>
