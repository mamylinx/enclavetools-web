---
import Layout from "../../layouts/Layout.astro";
import SoftwareApplicationSchema from "../../components/schema/SoftwareApplicationSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import ToolActions from "../../components/tool/ToolActions.astro";
import ToolBreadcrumb from "../../components/tool/ToolBreadcrumb.astro";
import ToolSidebar from "../../components/tool/ToolSidebar.astro";
import ToolOverview from "../../components/tool/ToolOverview.astro";
import ToolTechnical from "../../components/tool/ToolTechnical.astro";
import ToolPrivacy from "../../components/tool/ToolPrivacy.astro";
import ToolSetup from "../../components/tool/ToolSetup.astro";
import ToolHardware from "../../components/tool/ToolHardware.astro";
import ToolWorksWith from "../../components/tool/ToolWorksWith.astro";
import ToolRelated from "../../components/tool/ToolRelated.astro";
import ToolShareButtons from "../../components/tool/ToolShareButtons.astro";
import ToolPrivacyAuditCta from "../../components/tool/ToolPrivacyAuditCta.astro";
import ToolLlmSizingCta from "../../components/tool/ToolLlmSizingCta.astro";
import toolsData from "../../data/generated/tools.json";
import { getWorksWith } from "../../utils/toolModel";

export function getStaticPaths() {
  const allTools = toolsData.tools.flatMap((cat: any) =>
    cat.content.map((tool: any) => ({
      ...tool,
      category: cat.category,
    })),
  );
  return allTools.map((tool: any) => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;

const allTools = toolsData.tools.flatMap((cat: any) =>
  cat.content.map((tool: any) => ({
    ...tool,
    category: cat.category,
  })),
);

const tool = allTools.find((t: any) => t.slug === slug);
if (!tool) {
  return Astro.redirect("/404");
}

const category = tool.category;
const enrichedTool = tool;
const worksWithTools = getWorksWith(enrichedTool, allTools, 4);

const relatedTools = allTools
  .filter((t: any) => t.category === category && t.slug !== slug)
  .sort(
    (a: any, b: any) => (b.popularity_score || 0) - (a.popularity_score || 0),
  )
  .slice(0, 4);

const formatDate = (dateStr: string) => {
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return dateStr;
  }
};

const canonicalUrl = `https://enclavetools.com/tools/${tool.slug}`;
const faviconUrl = `/favicons/${slug}.png`;

const seoTitle = tool.title;
const seoDescription = tool.body;

const categoryTitle = category
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");

const breadcrumbs = [
  { name: "Home", url: "https://enclavetools.com" },
  { name: categoryTitle, url: `https://enclavetools.com/${category}` },
  { name: tool.title },
];

const encodedShareText = encodeURIComponent(
  `Check out ${enrichedTool.title} - ${enrichedTool.body}`,
);
const encodedCanonicalUrl = encodeURIComponent(canonicalUrl);
const xShareUrl = `https://x.com/intent/post?text=${encodedShareText}&url=${encodedCanonicalUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedCanonicalUrl}`;

const yesNo = (value: boolean) => (value ? "Yes" : "No");
const scorecard = [
  ["License", enrichedTool.license || "Not specified"],
  ["Commercial use", yesNo(enrichedTool.commercial_use)],
  ["OpenAI-compatible API", yesNo(enrichedTool.openai_api)],
  ["REST API", yesNo(enrichedTool.rest_api)],
  ["Fine-tuning support", yesNo(enrichedTool.fine_tuning)],
  [
    "Quantization support",
    enrichedTool.quantization
      ? enrichedTool.model_format?.join(", ") || "Yes"
      : "No",
  ],
  ["Docker available", yesNo(enrichedTool.docker_available)],
  ["GUI / no-code available", yesNo(enrichedTool.gui_available)],
  ["Telemetry", enrichedTool.telemetry],
  ["Offline after setup", yesNo(enrichedTool.offline_after_setup)],
];

const featureBadges = [
  categoryTitle,
  enrichedTool.license,
  enrichedTool.setup_difficulty
    ? `${enrichedTool.setup_difficulty} setup`
    : null,
  enrichedTool.popularity_score
    ? `${enrichedTool.popularity_score.toLocaleString("en-US")} stars`
    : null,
].filter(Boolean);
---

<Layout
  site={`Enclavetools - ${tool.title}`}
  title={tool.title}
  tagline={tool.body}
  pageTitle={seoTitle}
  pageDescription={seoDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={seoTitle}
  ogDescription={seoDescription}
  ogUrl={canonicalUrl}
  ogImage="/enclavetools.svg"
  ogType="website"
  ogSiteName="Enclavetools"
  twitterCard="summary"
  twitterTitle={seoTitle}
  twitterDescription={seoDescription}
  twitterImage={faviconUrl}
  pageFavicon={faviconUrl}
  showSearch={true}
  showHero={true}
>
  <SoftwareApplicationSchema
    name={tool.title}
    description={tool.body}
    url={tool.url}
    tag={tool.tag}
    dateAdded={tool["date-added"]}
    category={category}
    popularityScore={tool.popularity_score}
  />
  <BreadcrumbSchema items={breadcrumbs} />

  <div class="px-4 md:px-8 pt-12 pb-8">
    <section class="grid grid-cols-1 gap-12 max-w-[1400px] mx-auto items-end">
      <ToolActions {enrichedTool} {slug} {category} />
    </section>
  </div>

  <div class="max-w-[1400px] mx-auto px-4 md:px-8 pb-12">
    <ToolBreadcrumb {category} {categoryTitle} {enrichedTool} />

    <article class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)]">
      <ToolSidebar />

      <div class="flex flex-col">
        <ToolOverview {enrichedTool} {featureBadges} />
        <ToolTechnical {scorecard} />
        <ToolPrivacy {enrichedTool} {formatDate} />
        <ToolPrivacyAuditCta category={category} toolName={tool.title} />
        <ToolLlmSizingCta category={category} toolName={tool.title} calculatorModel={enrichedTool.calculator_model} />
        <ToolSetup {enrichedTool} {canonicalUrl} />
        <ToolHardware {enrichedTool} />
        <ToolWorksWith {slug} {worksWithTools} />
        <ToolRelated {relatedTools} />
        <ToolShareButtons {xShareUrl} {linkedinShareUrl} />
      </div>
    </article>
  </div>

  <script src="/scripts/tool-actions.js" type="module" defer></script>
</Layout>
