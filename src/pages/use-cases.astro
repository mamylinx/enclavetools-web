---
import Layout from "../layouts/Layout.astro";
import toolsData from "../data/tools.json";

const allTools = toolsData.tools.flatMap((cat: any) =>
  cat.content.map((tool: any) => ({
    ...tool,
    category: cat.category,
  })),
);

const sections = [
  {
    name: "Business Owner",
    copy: "Find tools that can be run by an IT contractor without turning client data into a cloud dependency.",
    categories: ["rag-document", "chat-interfaces", "workflow-automation"],
    href: "/?persona=Business+Owner&setup=Low&commercial=yes",
  },
  {
    name: "Developer / Engineer",
    copy: "Shortlist self-hosted infrastructure by API support, license, hardware target, and deployment path.",
    categories: ["llm-inference", "deployment", "monitoring-observability"],
    href: "/?persona=Developer&feature=openai_api&feature=docker_available",
  },
  {
    name: "Healthcare Professional",
    copy: "Look for offline tools that keep clinical notes and patient context inside the clinic network.",
    categories: ["chat-interfaces", "speech-to-text", "rag-document"],
    href: "/?persona=Healthcare&offline=yes&telemetry=None",
  },
  {
    name: "Legal Professional",
    copy: "Evaluate document review and private search workflows for contracts, discovery, and NDA-bound files.",
    categories: ["rag-document", "vector-databases", "chat-interfaces"],
    href: "/?persona=Legal&use=Contract+Review&commercial=yes",
  },
  {
    name: "Indie Hacker / Solo Builder",
    copy: "Find affordable embeddable AI pieces that run locally or on your own small server.",
    categories: ["llm-inference", "chat-interfaces", "agent-frameworks"],
    href: "/?persona=Indie+Hacker&use=Self-hosted+Inference",
  },
];

const featuredFor = (categories: string[]) => allTools
  .filter((tool: any) => categories.includes(tool.category))
  .sort((a: any, b: any) => (b.popularity_score || 0) - (a.popularity_score || 0))
  .slice(0, 3);
---

<Layout
  site="Enclavetools - Use Cases"
  title="Start from the risk you need to control."
  tagline="These entry points map non-technical and technical needs to categories, filters, and practical shortlists."
  eyebrow="Use cases"
  pageTitle="Private AI use cases"
  pageDescription="Persona-oriented entry points for private, local, and self-hosted AI tools."
  showSearch={true}
  showHero={true}
>
  <div class="px-4 md:px-10 pt-6 pb-12 md:pb-16">

    <div class="grid grid-cols-1 border-t border-gray-900">
      {sections.map((section) => (
        <section class="grid grid-cols-1 md:grid-cols-[0.85fr_1.15fr] gap-6 py-6 border-b border-gray-900">
          <div>
            <h2 class="text-[clamp(30px,4vw,58px)] leading-[0.95] font-black mb-3 text-gray-900">{section.name}</h2>
            <p class="max-w-[560px] text-gray-600 text-base leading-relaxed mb-4 font-medium">{section.copy}</p>
            <a href={section.href} class="font-black text-gray-900 hover:text-blue-600 transition-colors">Browse this view</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 border border-gray-900">
            {featuredFor(section.categories).map((tool: any) => (
              <a href={`/tools/${tool.slug}`} class="p-3.5 text-gray-900 border-b last:border-b-0 md:border-b-0 md:border-r border-gray-900 last:border-r-0 hover:bg-gray-50 transition-colors no-underline block h-full">
                <strong class="block text-lg font-black mb-2">{tool.title}</strong>
                <span class="block text-gray-600 leading-snug text-sm font-medium">{tool.body}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
